
# external envs set by buildroot:
#BINARIES_DIR=<...>/output/images
#HOST_DIR=<...>/output/host


#AES key generated by command:
#openssl enc -aes-256-cbc -pbkdf2 -iter 100000 -k MyAesKey -P -S f0e4cd5d4b196701
AES_KEY=16CD7B747BE2625A3DB7CC027B2853A7C91C09453EDC701E945E3AC7F6207BD1
#AES_IV=9F70FCEC206603D2AAD7B318CC2259EA

#RSA files (sign_priv.pem, sign_public.pem) generated by commands:
#openssl genrsa -aes256 -out sign_priv.pem -passout pass:"MyRsaPassw"
#openssl rsa -passin pass:"MyRsaPassw" -in sign_priv.pem -out sign_public.pem -outform PEM -pubout

RSA_PASSW="MyRsaPassw"

${BINARIES_DIR}/update.swu: sw-description $(BINARIES_DIR)/rootfs.ubifs sign_priv.pem
	mkdir -p files
	cp sw-description files/
	$(eval AES_IV=$(shell $(HOST_DIR)/bin/openssl rand -hex 16))
	$(HOST_DIR)/bin/openssl enc -aes-256-cbc -in $(BINARIES_DIR)/rootfs.ubifs -out files/rootfs.ubifs -K $(AES_KEY) -iv $(AES_IV)
	sed "s/size_orig_rootfs.ubifs/`du -b $(BINARIES_DIR)/rootfs.ubifs | cut -f 1`/g" -i files/sw-description
	sed "s/9F70FCEC206603D2AAD7B318CC2259EA/$(AES_IV)/g" -i files/sw-description
	sed "s/sha256_rootfs.ubifs/`sha256sum files/rootfs.ubifs | cut -d ' ' -f 1`/g" -i files/sw-description
	$(HOST_DIR)/bin/openssl dgst -sha256 -sign sign_priv.pem -passin pass:"$(RSA_PASSW)" files/sw-description > files/sw-description.sig
	(cd files && for i in sw-description sw-description.sig rootfs.ubifs; do echo $${i}; done | cpio -ov -H crc > $@)
	rm -rf files
