/*
 * INMYS NMS-SM-EVM V1 - default carrier board for NMS-SM-K1892VM21YA
 *
 * Carrier resources (see HARDWARE.md):
 *   X6   SMARC 2.1 edge connector (314 pin, AS0B826-S78B-7H)
 *   X5   microSD socket                       (module SDMMC0)
 *   X7   RJ45 GbE0, X8 RJ45 GbE1              (module DAP8211 PHYs)
 *   X4   HDMI type A via TPD12S016 (D1)       (module ADV7513)
 *   X23  DisplayPort                          (module DP)
 *   X33  PCIe x4 slot                         (module PCIe0)
 *   X19  miniPCIe                             (module PCIe1)
 *   X9   M.2 M-key (SATA via module TUSB9261)
 *   X10/X11 USB 3.0 / USB 2.0 host ports      (module TUSB8041 hub)
 *   X24/X25 30-pin FPC DSI0/DSI1 displays + touch
 *   X13..X16 CAN0/CAN1 terminals              (module MFBSP0/1)
 *   X34  fan connector + D32 ADT7473 fan controller
 *   D31  PCA9535 GPIO expander (I2C_PM)
 *   D30  PCA9546 I2C switch (I2C_GP -> GP_A / mPCIe / DSI0 / DSI1)
 *
 * Copyright (C) 2026 INMYS
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/pwm/pwm.h>

#include "nms-sm-k1892vm21ya.dtsi"

/ {
	model = "INMYS NMS-SM-K1892VM21YA V1 on NMS-SM-EVM V1";
	compatible = "inmys,nms-sm-evm",
		     "inmys,nms-sm-k1892vm21ya",
		     "inmys,nms-sm-k1892",
		     "elvees,mcom03r";

	chosen {
		stdout-path = "serial0:115200n8";
	};

	aliases {
		ethernet0 = &emac0;
		ethernet1 = &emac1;
	};

	hdmi_connector: hdmi-connector {
		compatible = "hdmi-connector";
		label = "hdmi";
		type = "a";

		port {
			hdmi_connector_in: endpoint {
				remote-endpoint = <&adv7513_out>;
			};
		};
	};
#if 0
	/*
	 * Backlight for the X24 panel.  SMARC LCD0_BKLT_EN (S127) -> R98 ->
	 * D20 level shifter -> X24.17, and LCD0_BKLT_PWM (S141) -> D20 ->
	 * X24.19.  The enable line is the module's PCAL6416A P0_0, owned by
	 * lcd0_bklt_en in the module device tree.
	 */
	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm 0 2000000>; /* 500 Hz, port 0 output B */
		power-supply = <&lcd0_bklt_en>;
		brightness-levels = <100 90 80 70 60 50 40 30 20 10 1 0>;
		default-brightness-level = <10>;
	};
#endif
};

/* ------------------------------------------------------------------ */
/* Console: SER0 (UART3, RS-232 transceiver on the carrier)           */
/* ------------------------------------------------------------------ */

&uart3 {
	status = "okay";
};

/* SER1_DBG (UART0 via the D33 crossbar) is the debug console */
&uart0 {
	status = "okay";
};

/* ------------------------------------------------------------------ */
/* Carrier I2C devices                                                */
/* ------------------------------------------------------------------ */

/* I2C_PM: PCA9535 (D31) */
&i2c0 {
	status = "okay";
	clock-frequency = <100000>;

	carrier_gpio: gpio@20 {
		compatible = "nxp,pca9535";
		reg = <0x20>;
		gpio-controller;
		#gpio-cells = <2>;

		gpio-line-names =
			"DSI0_TP_RST_N", "DSI1_TP_RST_N",
			"DSI0_RST_N", "DSI1_RST_N",
			"CAM0_PWDN#", "I2C_GPIO05",
			"I2C_GPIO06", "I2C_GPIO07",
			"I2C_GPIO10", "I2C_GPIO11",
			"I2C_GPIO12", "I2C_GPIO13",
			"I2C_GPIO14", "I2C_GPIO15",
			"I2C_GPIO16", "I2C_GPIO17";
	};
};

/* I2C_GP: fan controller (D32) and I2C switch (D30) */
&i2c1 {
	status = "okay";
	clock-frequency = <100000>;

	/* ADT7473ARQZ fan controller, 7-bit address 0x2e */
	fan_controller: hwmon@2e {
		compatible = "adi,adt7473";
		reg = <0x2e>;
	};

	i2c_gp_switch: i2c-switch@70 {
		compatible = "nxp,pca9546";
		reg = <0x70>;
		#address-cells = <1>;
		#size-cells = <0>;

		i2c_gp_a: i2c@0 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0>;
		};

		i2c_mpcie: i2c@1 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <1>;
		};

		i2c_dsi0: i2c@2 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <2>;
		};

		i2c_dsi1: i2c@3 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <3>;
		};
	};
};

/* i2c_gp_a: X32 "PLD-10" expansion header */
/* i2c_mpcie: miniPCIe socket X19 */

/* ------------------------------------------------------------------ */
/* HDMI (X4) - ADV7513 is on the module, TPD12S016 on the carrier     */
/* ------------------------------------------------------------------ */

&adv7513 {
	status = "okay";

	ports {
		port@1 {
			reg = <1>;

			adv7513_out: endpoint {
				remote-endpoint = <&hdmi_connector_in>;
			};
		};
	};
};

/* ------------------------------------------------------------------ */
/* LVDS panel (X24) - SN65DSI84 on the module drives SMARC LVDS0        */
/* ------------------------------------------------------------------ */

/*
 * X24 is a 30-pin FPC carrying LVDS0 (S125..S138) plus the LCD0 controls;
 * X25 is the same for LVDS1 / LCD1 and is not described yet.  The panel
 * itself is the 7" 800x480 unit whose timing lives in the module device
 * tree; only the carrier-side wiring is added here.
 *
 * Panel power is SMARC LCD0_VDD_EN (S133) -> R96 -> D22 -> X24.11, which
 * the module drives from PCAL6416A P0_1.
 */
&lvds_bridge {
	status = "okay";
};

#if 0
/*
 * Backlight PWM.  SMARC LCD0_BKLT_PWM (S141) is D2.AW17 = GPIO1_PORTD_3,
 * whose alternate function is PWM_OENB0 - port 0 output B of the
 * elvees-pwm block at 0x1770000 - so elvees,output-channel[0] = 1 selects
 * the B output.  The designware timers cannot reach this pin; see the
 * module device tree.
 */
&pwm {
	status = "okay";
	elvees,output-channel = <1 0 0 0>;
	elvees,state-on-disable = <1 0 0 0>;
	pinctrl-names = "default";
	pinctrl-0 = <&pwm_oenb0_mux>;
};
#endif

&lvds_panel {
	status = "okay";
#if 0
	backlight = <&backlight>;
#endif
	power-supply = <&lcd0_vdd_en>;
};

/* ------------------------------------------------------------------ */
/* PCIe (X33 x4 slot on PCIe0, X19 miniPCIe on PCIe1)                 */
/* ------------------------------------------------------------------ */

/*
 * No reset-gpio here.  The controller drives the PCIx_PERSTN pad itself and
 * only falls back to that when the property is absent.  The
 * `reset-gpios = <&gpio0b 4 GPIO_ACTIVE_LOW>` that used to sit here was
 * doubly wrong: the driver looks for "reset-gpio" (singular), and
 * GPIO0_PORTB_4 is ball BB34 = WDT_TIME_OUT# on SMARC S145, not a PCIe
 * reset at all.
 */
&pcie0 {
	status = "okay";
};

