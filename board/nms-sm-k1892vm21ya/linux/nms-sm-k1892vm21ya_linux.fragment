# Kernel configuration fragment for the INMYS NMS-SM-K1892VM21YA module.
#
# This rootfs uses devtmpfs without udev platform-driver autoloading.
# Drivers needed at boot are built in or explicitly loaded by S11modules
# from /etc/modules-load.d. The ELVEES defconfig leaves many drivers as =m.

# --- I2C muxes ------------------------------------------------------------
# D30 PCA9540B (I2C_INT / I2C_INT_1V8) and D29 PCA9546A (CAM0/CAM1/LCD).
# With =m the muxes never bind, no child adapters are created and every
# device behind them (RTC, GPIO expander, EEPROMs, bridges) is invisible.
CONFIG_I2C_MUX=y
CONFIG_I2C_MUX_PCA954x=y

# --- USB ----------------------------------------------------------------
# The TUSB9261 (D16) has no firmware flash of its own and on this module D15
# is blank, so the bridge sits in its HID boot loader (0451:926b).  hidapi's
# hidraw backend is what tusb926x-flash-burner uses to reach it, and the
# ELVEES defconfig has HIDRAW switched off.
CONFIG_HIDRAW=y

# --- WiFi (PCIe) --------------------------------------------------------
# The M.2 slot has been seen with an Intel AX210 (8086:2725, Typhoon Peak,
# iwlwifi-ty-*) and with a Dual Band Wireless-AC 7265 (8086:095a, Stone Peak
# 2, iwlwifi-7265D-*); both are driven by iwlmvm.
#
# The whole stack is modular on purpose.  Built in, iwlwifi probes from its
# PCI driver initcall at 2.86 s and asks for its firmware before the root
# filesystem is mounted at 3.48 s - "Direct firmware load ... failed with
# error -2" and no wlan0.  cfg80211 has the same problem with
# regulatory.db.  There is no initramfs, so the only way to have the
# firmware available in time is to load the driver after boot, which is what
# /etc/init.d/S11modules does with /etc/modules-load.d/iwlwifi.conf.
#
# IWLWIFI=m makes IWLWIFI_OPMODE_MODULAR default to y, so iwlmvm is a
# separate module and that is the one to load; modprobe pulls in iwlwifi,
# mac80211 and cfg80211 through modules.dep.
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_CFG80211_CRDA_SUPPORT=y
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
# CONFIG_IWLDVM is not set
CONFIG_IWLWIFI_LEDS=y
# CONFIG_IWLWIFI_DEBUGFS is not set
# CONFIG_IWLWIFI_DEVICE_TRACING is not set

# --- RTC --------------------------------------------------------------
# D8 PCF8523TK on the 1.8 V branch of the PCA9540B (bus 9, address 0x68).
# The ELVEES defconfig has no RTC support at all, so /sys/class/rtc is
# empty and hwclock has nothing to talk to.
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_PCF8523=y
# Seed the system clock from the RTC at boot and write it back on
# shutdown, so the time survives a power cycle without NTP.
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_SYSTOHC=y

# --- Audio ------------------------------------------------------------
# Two independent paths:
#   analog - SoC MFBSP0 -> ES8327 on the ELV-SMARC-CB (I2C_GP, 0x18)
#   HDMI   - SoC I2S0   -> ADV7513 on the module
# The ELVEES defconfig leaves the whole sound stack as =m.  Modules do get
# installed into the rootfs, but nothing loads them: there is no udev and
# /etc/modules-load.d is empty, so /proc/asound never appears.  Build the
# pieces in instead of adding an init script for each of them.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SIMPLE_CARD=y
CONFIG_SND_DESIGNWARE_I2S=y
CONFIG_SND_SOC_ELVEES_MFBSP=y
CONFIG_SND_SOC_ES8326=y
# Selected by DRM_I2C_ADV7511_AUDIO, which is already =y
CONFIG_SND_SOC_HDMI_CODEC=y

# --- Display --------------------------------------------------------------
# D10 SN65DSI84 DSI->dual-LVDS bridge and D19 ADV7513 HDMI transmitter.
CONFIG_DRM_TI_SN65DSI83=y
CONFIG_DRM_I2C_ADV7511=y

# LVDS panel (XP7 on the ELV-SMARC-CB) and the generic "hdmi-connector".
CONFIG_DRM_PANEL_LVDS=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_DRM_DISPLAY_CONNECTOR=y

# Panel backlight is driven by ELVEES PWM timer 0 output B.
CONFIG_BACKLIGHT_PWM=y
CONFIG_PWM_ELVEES=y
CONFIG_PWM_DWC_CORE=y
CONFIG_PWM_DWC_OF=y

# --- Fan: D35 EMC2301 or SoC PWM, selected in the module DTSI ------------
CONFIG_SENSORS_EMC2305=y
CONFIG_SENSORS_PWM_FAN=y

# --- CAN ---------------------------------------------------------------
# MFBSP0/1 use LDAT6/7; MFBSP0 audio uses other pins and can coexist.
# On-board controllers need no firmware; register them before userspace.
CONFIG_CAN=y
CONFIG_CAN_RAW=y
CONFIG_CAN_DEV=y
CONFIG_CAN_CALC_BITTIMING=y
CONFIG_CAN_MFBSP_CAN=y

# STM32 firmware 0.9 exposes GPIOs/IRQs through the standard PCAL6416 driver.
CONFIG_GPIO_PCA953X=y
CONFIG_GPIO_PCA953X_IRQ=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_GPIO=y

# Direct SoC GPIO to STM32 PB10/TP1 signals final shutdown; no TF-A hook.
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_GPIO=y
