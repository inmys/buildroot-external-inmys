/* Carrier choice is independent of the A/B slot and survives updates. */
fdtfile=elvees/nms-sm-elvsmarccb.dtb
active_slot=A
upgrade_available=0
bootcount=0
altbootcmd=run nms_rollback; run nms_boot; run distro_bootcmd

/* Only NMS Buildroot slots carry /etc/nms-ab. Other distributions use
 * the normal distro_bootcmd after this command returns. */
nms_boot=
	if test "${active_slot}" = B; then setenv other_slot A;
	else setenv active_slot A; setenv other_slot B; fi;
	for target in ${boot_targets}; do
		setenv devnum;
		if test "${target}" = mmc0; then setenv devnum 0; fi;
		if test "${target}" = mmc1; then setenv devnum 1; fi;
		if test -n "${devnum}"; then
			if mmc dev ${devnum}; then
				for nms_slot in ${active_slot} ${other_slot}; do
					if test "${nms_slot}" = A; then setenv rootpart 1;
					else setenv rootpart 2; fi;
					if test -e mmc ${devnum}:${rootpart} /etc/nms-ab; then
						if part uuid mmc ${devnum}:${rootpart} rootuuid; then
							echo NMS: booting ${target} slot ${nms_slot};
							sysboot mmc ${devnum}:${rootpart} any ${pxefile_addr_r} /boot/extlinux/extlinux.conf;
						fi;
					fi;
				done;
			fi;
		fi;
	done

/* bootcount is persisted only while an update awaits confirmation. */
nms_rollback=
	if test "${active_slot}" = B; then setenv active_slot A;
	else setenv active_slot B; fi;
	setenv upgrade_available 0;
	setenv bootcount 0;
	saveenv;
	echo NMS: rolling back to slot ${active_slot}
