# Common module configuration, on top of ELVEES mcom03r_defconfig.
CONFIG_DEFAULT_DEVICE_TREE="mcom03r-nms-sm-k1892vm21ya"
CONFIG_ENV_SOURCE_FILE="nms-sm-k1892vm21ya"
CONFIG_CMD_GPIO=y
CONFIG_I2C_MUX=y
CONFIG_I2C_MUX_PCA954x=y
CONFIG_SPI_FLASH_SFDP_SUPPORT=y

# QSPI: two 64 KiB sectors. MMC offsets are specified in the U-Boot DTS.
# CONFIG_ENV_IS_NOWHERE is not set
CONFIG_ENV_IS_IN_SPI_FLASH=y
CONFIG_ENV_IS_IN_MMC=y
CONFIG_SYS_REDUNDAND_ENVIRONMENT=y
CONFIG_ENV_OFFSET=0xfe0000
CONFIG_ENV_OFFSET_REDUND=0xff0000
CONFIG_ENV_SIZE=0x10000
CONFIG_ENV_SECT_SIZE=0x10000
CONFIG_ENV_MMC_USE_DT=y
# Refresh a removable medium's saved MACs from this module's EUI-48 EEPROMs.
CONFIG_ENV_OVERWRITE=y
CONFIG_SYS_MMC_ENV_DEV=0
CONFIG_SYS_MMC_ENV_PART=0
CONFIG_BOOTCOMMAND="run nms_boot; run distro_bootcmd"
CONFIG_BOOTCOUNT_LIMIT=y
CONFIG_BOOTCOUNT_ENV=y
CONFIG_BOOTCOUNT_BOOTLIMIT=3
