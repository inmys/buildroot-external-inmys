# INMYS NMS-SM-K1892VM21YA V1 - ddrinit configuration
#
# LPDDR4: 2 x Rayson RS512M32LO4D1BDS-46IT (512M x32, 16 Gbit each)
#   D27 -> DDRMC0 (channels MEMA/MEMB), D28 -> DDRMC1 (channels MEMC/MEMD)
#   single rank per channel (CS1/CKE1 are NC on the package),
#   x16 per channel, row 16, col 10, bank 3, page 2 KiB, 2133 MT/s
#
# DQ mapping is identity: the PCB routes SoC DDRn_Dx straight to the
# corresponding device DQx (see sdk2/HARDWARE.md, "DRAM DQ mapping").
CONFIG_DRAM_TYPE_LPDDR4=y
CONFIG_DDRMC_ACTIVE_0_1=y
CONFIG_BURST_LEN=16
CONFIG_UART_BASE_FREQ=27000000
CONFIG_DDR_XTAL_FREQ=27000000
CONFIG_DRAM_RATE_2133=y
CONFIG_READ_DBI=y
CONFIG_WRITE_DBI=y
CONFIG_DRAM_RANKS_1=y
CONFIG_DQ_MAPPING=y
CONFIG_DDRMC0_DQ_MAPPING_BYTE0=0x76543210
CONFIG_DDRMC0_DQ_MAPPING_BYTE1=0x76543210
CONFIG_DDRMC0_DQ_MAPPING_BYTE2=0x76543210
CONFIG_DDRMC0_DQ_MAPPING_BYTE3=0x76543210
CONFIG_DDRMC1_DQ_MAPPING_BYTE0=0x76543210
CONFIG_DDRMC1_DQ_MAPPING_BYTE1=0x76543210
CONFIG_DDRMC1_DQ_MAPPING_BYTE2=0x76543210
CONFIG_DDRMC1_DQ_MAPPING_BYTE3=0x76543210
CONFIG_DRAM_DEVICE_WIDTH_X16=y
CONFIG_DRAM_ROW_ADDR_BITS=16
CONFIG_DRAM_COLUMN_ADDR_BITS=10
CONFIG_DRAM_BANK_ADDR_BITS=3
CONFIG_PHY_ODT_120=y
CONFIG_PHY_TX_IMPEDANCE_40=y
CONFIG_PHY_ATX_IMPEDANCE_40=y
CONFIG_DRAM_RTT_NOM_120=y
CONFIG_DRAM_CA_ODT_40=y
CONFIG_SOC_ODT_120=y
