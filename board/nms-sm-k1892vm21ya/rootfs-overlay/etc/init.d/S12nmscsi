#!/bin/sh
# Carrier wiring for Felix; sensor type is selected by inmys-vision at runtime.
set -eu
case "${1:-}" in
start)
    compatible=$(tr '\000' '\n' </proc/device-tree/compatible)
    case "$compatible" in
    *inmys,nms-sm-evm*)
        csi=1; node=/proc/device-tree/media-bus/dphy@1323040
        power=$(gpiofind 'CAM0_PWDN#')
        # X12 has PWDN but no independent reset wire.
        reset_need=0; reset_chip=${power% *}; reset_line=-1
        ;;
    *inmys,nms-sm-elvsmarccb*)
        csi=0; node=/proc/device-tree/media-bus/dphy@1323000
        power=$(gpiofind 'GPIO0_CAM0_PWR#')
        reset=$(gpiofind 'GPIO2_CAM0_RST#')
        reset_need=1; reset_chip=${reset% *}; reset_line=${reset#* }
        ;;
    *) exit 0 ;;
    esac
    [ -f "$node/status" ] || exit 0
    [ "$(tr -d '\000' < "$node/status")" = okay ] || exit 0
    modprobe dmabuf_exporter
    modprobe Felix
    # D1 CAM_SEL inputs have no external pulls. Keep the former idle 00
    # selection using PCAL6416 bias registers; lines stay free for gpioset.
    gpioget -B pull-down $(gpiofind CAM_SEL0) >/dev/null
    gpioget -B pull-down $(gpiofind CAM_SEL1) >/dev/null
    power_chip=${power% *}; power_chip=${power_chip#gpiochip}
    reset_chip=${reset_chip#gpiochip}
    model=$(tr -d '\000' </proc/device-tree/model)
    mkdir -p /etc/felix/boardcfg /dev/dri/by-path
    [ ! -e /dev/dri/card0 ] || ln -sf ../card0 /dev/dri/by-path/platform-1300000.dp-card
    {
        echo "# Generated by S12nmscsi; physical CSI$csi, I2C_CAM0 bus 5."
        echo "-Board_reset_need $reset_need"
        echo '-Board_mux_need 0'
        echo '-Board_pwdn_value 1'
        echo "-Board_max_sensors $((csi + 1))"
        echo '-Board_clock_frequency 24.0'
        # Felix indexes GPIO/I2C settings by sensor suffix, not I2C_CAM name.
        # Populate the unused slot 0 too: vendor board parameters are an array.
        for index in $(seq 0 "$csi"); do
            echo "-Sensor${index}_i2c 5"
            echo "-Sensor${index}_gpiochip_reset $reset_chip"
            echo "-Sensor${index}_gpio_reset $reset_line"
            echo "-Sensor${index}_gpiochip_pwdn $power_chip"
            echo "-Sensor${index}_gpio_pwdn ${power#* }"
        done
    } > "/etc/felix/boardcfg/$model.cfg"
    cat > /run/inmys-camera.conf <<CFG
csi $csi
i2c 5
power_chip $power_chip
power_line ${power#* }
power_on 1
reset_chip $reset_chip
reset_line $reset_line
CFG
    echo "CSI$csi: Felix ready on I2C_CAM0; GPIOs resolved by name"
    ;;
stop) ;;
*) echo "Usage: $0 {start|stop}" >&2; exit 1 ;;
esac
