#!/bin/sh
#
# Restore the board multiplexer state after boot: the PCAL6416A comes out of
# reset with every pin as an input, so the muxes fall back to their pull
# resistors until nms-gpio.sh drives them again.
#

case "$1" in
start)
	printf "Restoring board muxes: "
	/usr/sbin/nms-gpio.sh status > /dev/null && echo "OK"
	;;
stop)
	;;
*)
	echo "Usage: $0 {start|stop}"
	exit 1
	;;
esac
