#!/bin/sh
#
# Mount the A/B boot partition.  It is p1 of whatever disk the root
# filesystem lives on, so the same script works on the SD card and on the
# eMMC.  /etc/fstab cannot do this: busybox mount resolves LABEL= through
# /dev/disk/by-label, which needs udev, and this system has none.
[ -x /usr/sbin/nms-ab ] || exit 0
. /usr/sbin/nms-ab

dev=$(nms_ab_boot_dev) || exit 0
mkdir -p /boot
mountpoint -q /boot && exit 0
mount -t vfat "$dev" /boot 2>/dev/null || true
