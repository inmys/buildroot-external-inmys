#!/bin/sh
#
# Release the TUSB8041 hub from SMBus configuration mode so that it connects
# to the SoC's USB0 upstream port.  Without this the hub, the TUSB9261
# USB-SATA bridge and the SMARC USB0..USB2 ports never enumerate.
#
# The hub connects late, which is fine: USB hubs are allowed to appear at any
# time and the kernel enumerates the tree as soon as the upstream link comes
# up.  Running before S40network simply means the ports are ready by the time
# anything wants them.
#

case "$1" in
start)
	printf "Releasing USB hub: "
	/usr/sbin/nms-usbhub
	;;
stop)
	;;
*)
	echo "Usage: $0 {start|stop}"
	exit 1
	;;
esac
