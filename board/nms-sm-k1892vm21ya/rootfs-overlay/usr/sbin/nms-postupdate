#!/bin/sh
#
# SWUpdate post-update hook.
#
# Runs after the daemon has installed a package successfully.  The slot
# that was written is recorded by nms_ab_prepare(), so all that is left is
# to point extlinux.conf at it - exactly what nms-update does on the
# command line.
set -eu

. /usr/sbin/nms-ab

slot=$(cat /run/swupdate/.target-slot 2>/dev/null) || slot=""
[ -n "$slot" ] || exit 0

if nms_ab_set "$slot"; then
	echo "nms-postupdate: extlinux.conf now defaults to $slot, reboot to switch"
else
	echo "nms-postupdate: cannot flip extlinux.conf to $slot" >&2
	exit 1
fi
