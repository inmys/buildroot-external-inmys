#!/bin/sh
#
# A/B slot helpers for NMS-SM-K1892VM21YA.
#
# The boot partition is shared and U-Boot is stock distro-boot, so the
# active slot is whatever extlinux.conf says, and the root filesystem is
# told which one it is by root= on the kernel command line.  Nothing is
# stored anywhere: derive everything from /proc/cmdline and /sys.

# Print A or B for the running root filesystem.
nms_ab_slot() {
	want=$(sed -n 's/.*root=PARTUUID=\([^ ]*\).*/\1/p' /proc/cmdline)
	[ -n "$want" ] || return 1
	for u in /sys/class/block/*/uevent; do
		grep -qx "PARTUUID=$want" "$u" 2>/dev/null || continue
		case "$want" in
		*-02) echo A ;;
		*-03) echo B ;;
		*) return 1 ;;
		esac
		return 0
	done
	return 1
}

# Print the block device of the running root filesystem.
nms_ab_root_dev() {
	want=$(sed -n 's/.*root=PARTUUID=\([^ ]*\).*/\1/p' /proc/cmdline)
	[ -n "$want" ] || return 1
	for u in /sys/class/block/*/uevent; do
		grep -qx "PARTUUID=$want" "$u" 2>/dev/null || continue
		echo "/dev/$(basename "$(dirname "$u")")"
		return 0
	done
	return 1
}

# Print the block device of the other slot's root filesystem.
nms_ab_other_root_dev() {
	root=$(nms_ab_root_dev) || return 1
	slot=$(nms_ab_slot) || return 1
	disk=${root%p*}
	case "$slot" in
	A) echo "${disk}p3" ;;
	B) echo "${disk}p2" ;;
	esac
}

# Print the block device of the boot partition (p1 of the same disk).
nms_ab_boot_dev() {
	root=$(nms_ab_root_dev) || return 1
	echo "${root%p*}p1"
}

# Print the other slot's name.
nms_ab_other_slot() {
	case "$(nms_ab_slot)" in
	A) echo B ;;
	B) echo A ;;
	*) return 1 ;;
	esac
}

# Prepare /run/swupdate so that a sw-description written for <slot> can be
# installed.  The device paths in sw-description are symlinks, which is what
# makes one package work for both slots and for both boot media.  /boot is
# mounted here because the per-slot kernel and device trees live on it.
nms_ab_prepare() {
	slot=$1
	[ -n "$slot" ] || return 1

	dev=$(nms_ab_other_root_dev) || return 1
	[ -b "$dev" ] || return 1

	bootdev=$(nms_ab_boot_dev) || return 1
	mkdir -p /boot
	mountpoint -q /boot || mount -t vfat "$bootdev" /boot || return 1

	rm -rf /run/swupdate
	mkdir -p /run/swupdate
	ln -sfn "$dev" "/run/swupdate/rootfs-$slot"
	ln -sfn "/boot/Image.$slot" "/run/swupdate/Image-$slot"
	for dtb in /boot/nms-*.dtb; do
		[ -f "$dtb" ] || continue
		name=$(basename "$dtb")
		case "$name" in
		*."$slot".dtb)
			ln -sfn "$dtb" "/run/swupdate/${name%.$slot.dtb}-$slot.dtb"
			;;
		esac
	done

	# Remembered for nms-postupdate, which runs in a fresh shell.
	echo "$slot" > /run/swupdate/.target-slot
}

# Point extlinux.conf at a slot.  /boot must already be mounted.
# Kernel command line options this hardware cannot do without.  They are
# re-applied to every extlinux label after an update, because an A/B update
# replaces the kernel and the rootfs but not the boot configuration on the
# FAT partition: a board flashed before an option was introduced would
# otherwise keep booting without it forever.
#
#   pcie_aspm=off     PCI0_CLKREQ (D2.G13) and PCI1_CLKREQ (D2.G15) are
#                     unconnected on this module - the nets NetD2_G13 and
#                     NetD2_G15 have no other member - while the endpoints
#                     reach PCIE_A_CLKREQ#/PCIE_B_CLKREQ# only through the
#                     clock buffer D5 to the SMARC connector.  An Intel WiFi
#                     card drops CLKREQ# as soon as its firmware is running
#                     and expects the host to bring the reference clock back;
#                     the SoC never sees the request, so L1 entry wedges the
#                     link.  ASPM has to stay off until the pad is wired.
#   pcie_port_pm=off  keeps the root port out of D3hot for the same reason.
NMS_CMDLINE="pcie_aspm=off pcie_port_pm=off"

nms_ab_ensure_cmdline() {
	[ -f /boot/extlinux/extlinux.conf ] || return 1
	tmp=/boot/extlinux/.extlinux.new
	awk -v opts="$NMS_CMDLINE" '
		/^[[:space:]]*append[[:space:]]/ {
			n = split(opts, want, " ")
			for (i = 1; i <= n; i++) {
				present = 0
				for (j = 2; j <= NF; j++)
					if ($j == want[i]) present = 1
				if (!present) $0 = $0 " " want[i]
			}
		}
		{ print }
	' /boot/extlinux/extlinux.conf > "$tmp" || return 1
	mv "$tmp" /boot/extlinux/extlinux.conf && sync
}

nms_ab_set() {
	[ -f /boot/extlinux/extlinux.conf ] || return 1
	cur=$(sed -n 's/^default[[:space:]]*//p' /boot/extlinux/extlinux.conf)
	[ -n "$cur" ] || return 1
	# Labels are "<carrier>_<slot>".  The carrier this image was built for
	# wins over the one in the current default line: when a module is moved
	# to a different carrier the FAT partition still carries the labels of
	# the image that created it, and the update is exactly the moment to
	# point it at the new device tree.
	carrier=$(cat /etc/nms-carrier 2>/dev/null)
	[ -n "$carrier" ] || carrier=${cur%_*}
	new=${carrier}_$1
	grep -qx "label $new" /boot/extlinux/extlinux.conf || return 1
	sed -i "s/^default[[:space:]].*/default $new/" /boot/extlinux/extlinux.conf
	sync
}
