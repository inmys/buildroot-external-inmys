#!/bin/sh
#
# Bring up the TUSB8041 four-port USB 3.0 hub (D14) on I2C_INT.
#
# The hub's SMBUSz strap is pulled low by R128, so the hub powers up as an
# SMBus slave instead of using its pin-strap defaults.  In that mode it sets
# cfgActive (Device Status and Command Register, offset 0xF8, bit 0) and
# "does not connect on the upstream port while this bit is 1" - the whole
# downstream tree (TUSB9261 USB-SATA bridge, the carrier hub and the three
# SMARC USB ports) stays invisible until a host clears it.
#
# cfgActive is clear-by-writing-1, and a write of 0 has no effect, so the
# value written is 0x01 even though the desired value is 0.  Bit 1 of the
# same register is smbusRst (also write-1-to-act), which is why the read
# value is masked rather than compared to 1.
#
# Upstream Linux has no driver for the TUSB8041 SMBus interface, so this has
# to be done from user space.  It only has to happen once per hub reset.
#
# Two things vary from module to module and must not be hard-coded:
#
#   - the SMBus slave address.  The datasheet derives it from the
#     GANGED/SMBA2 strap, and modules in the field have been seen at 0x44
#     and at 0x47, so the whole 0x44..0x47 window is probed;
#   - the adapter number of the I2C_INT channel, which depends on probe
#     order.  It is derived from the PCA9540B device tree node instead.
#

set -u

HUB_ADDRS="0x44 0x45 0x46 0x47"
REG_STATUS=0xf8
REG_VID_LSB=0x01
REG_VID_MSB=0x02
REG_PID_LSB=0x03
REG_PID_MSB=0x04

# I2C_INT is channel 0 of the PCA9540B at 0x70.  The kernel names the child
# adapter "i2c-<parent>-mux (chan_id 0)", and <parent> is the bus the mux
# itself sits on, so the pair can be matched up without assuming any number.
find_bus() {
	for d in /sys/bus/i2c/devices/*-0070; do
		[ -d "$d" ] || continue
		p=${d##*/}
		p=${p%%-*}
		for b in /sys/bus/i2c/devices/i2c-*; do
			[ "$(cat "$b/name" 2>/dev/null)" = "i2c-$p-mux (chan_id 0)" ] || continue
			echo "${b##*/i2c-}"
			return 0
		done
	done
	return 1
}

# Confirm the TI vendor and product IDs before writing anything: the probe
# window overlaps addresses that other parts could legitimately answer on.
find_hub() {
	bus=$1
	for a in $HUB_ADDRS; do
		[ "$(i2cget -y "$bus" "$a" $REG_VID_LSB 2>/dev/null)" = "0x51" ] || continue
		[ "$(i2cget -y "$bus" "$a" $REG_VID_MSB 2>/dev/null)" = "0x04" ] || continue
		[ "$(i2cget -y "$bus" "$a" $REG_PID_LSB 2>/dev/null)" = "0x40" ] || continue
		[ "$(i2cget -y "$bus" "$a" $REG_PID_MSB 2>/dev/null)" = "0x81" ] || continue
		echo "$a"
		return 0
	done
	return 1
}

bus=$(find_bus) || {
	echo "nms-usbhub: PCA9540B channel 0 not found"
	exit 0
}

addr=$(find_hub "$bus") || {
	echo "nms-usbhub: TUSB8041 not found on bus $bus"
	exit 0
}

reg=$(i2cget -y "$bus" "$addr" $REG_STATUS 2>/dev/null) || {
	echo "nms-usbhub: cannot read register 0xF8 on bus $bus addr $addr"
	exit 1
}

if [ $((reg & 1)) -eq 0 ]; then
	echo "nms-usbhub: hub at $addr on bus $bus already active (0xF8=$reg)"
	exit 0
fi

if i2cset -y "$bus" "$addr" $REG_STATUS 0x01; then
	echo "nms-usbhub: cleared cfgActive at $addr on bus $bus (0xF8 was $reg)"
else
	echo "nms-usbhub: write to register 0xF8 failed at $addr on bus $bus"
	exit 1
fi
