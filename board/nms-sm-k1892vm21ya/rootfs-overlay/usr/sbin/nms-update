#!/bin/sh
# One update path for CLI and SWUpdate web uploads.
set -eu
[ -r /run/nms-boot ] || { echo 'NMS boot setup is unavailable' >&2; exit 1; }
. /run/nms-boot
case "${1:-}" in
target)
    echo "$next" ;;
status)
    echo "Running: $slot ($root); update target: $next ($nextdev)"
    fw_printenv active_slot fdtfile upgrade_available bootcount ;;
prepare)
    [ -b "$nextdev" ] && [ "$nextdev" != "$root" ]
    if awk -v dev="$nextdev" '$1 == dev { found=1 } END { exit !found }' /proc/mounts; then
        echo "Refusing to overwrite mounted $nextdev" >&2
        exit 1
    fi
    mountpoint -q /data
    fw_printenv active_slot fdtfile >/dev/null
    mkdir -p /run/swupdate
    rm -f /run/swupdate/rootfs-A /run/swupdate/rootfs-B
    ln -s "$nextdev" "/run/swupdate/rootfs-$next"
    echo "NMS: updating slot $next ($nextdev)" ;;
confirm)
    mountpoint -q /data
    if [ "$(fw_printenv -n upgrade_available)" = 1 ]; then
        printf 'active_slot %s\nupgrade_available 0\nbootcount 0\nustate 0\n' "$slot" | fw_setenv -s -
        echo "NMS: confirmed slot $slot"
    fi ;;
'')
    echo 'usage: nms-update <firmware.swu> | status' >&2; exit 1 ;;
*)
    [ -f "$1" ] || { echo "No such update: $1" >&2; exit 1; }
    exec swupdate-client "$1" ;;
esac
