#!/bin/sh
#
# Install a SWUpdate package into the inactive A/B slot.
#
#   nms-update /path/to/firmware.swu
#
# The running slot is never touched.  The package carries the root
# filesystem plus the kernel and the device tree; sw-description writes
# them to the symlinks prepared below, and the extlinux.conf "default"
# line is flipped only after swupdate has succeeded.
set -eu

. /usr/sbin/nms-ab

SWU=${1:-}
[ -n "$SWU" ] || { echo "usage: nms-update <firmware.swu>" >&2; exit 1; }
[ -f "$SWU" ] || { echo "nms-update: no such file: $SWU" >&2; exit 1; }

cur=$(nms_ab_slot)      || { echo "nms-update: cannot tell the running slot" >&2; exit 1; }
nxt=$(nms_ab_other_slot) || { echo "nms-update: cannot tell the other slot" >&2; exit 1; }
dev=$(nms_ab_other_root_dev) || { echo "nms-update: cannot find the other rootfs" >&2; exit 1; }
[ -b "$dev" ] || { echo "nms-update: $dev is not a block device" >&2; exit 1; }

# Mounts /boot if needed and points the sw-description device paths at the
# inactive slot, so the same package works on the SD card and on the eMMC.
nms_ab_prepare "$nxt" || {
	echo "nms-update: cannot prepare the inactive slot" >&2; exit 1; }

echo "nms-update: slot $cur -> $nxt ($dev)"
swupdate -v -e "stable,$nxt" -i "$SWU"

# Only reached when swupdate succeeded.
nms_ab_set "$nxt"
echo "nms-update: extlinux.conf now defaults to $nxt, reboot to switch"
