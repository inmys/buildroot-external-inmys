# SWUpdate configuration for NMS-SM-K1892VM21YA.
#
# Minimal on purpose: raw images plus zlib, no bootloader handler and no
# webserver.  A/B is handled by extlinux.conf, not by the U-Boot
# environment, so CONFIG_UBOOT is deliberately not set.
CONFIG_HAVE_DOT_CONFIG=y
CONFIG_DEFAULT_CONFIG_FILE="/etc/swupdate.cfg"
CONFIG_HW_COMPATIBILITY=y
CONFIG_BOOTLOADER_NONE=y
CONFIG_SSL_IMPL_OPENSSL=y
CONFIG_HASH_VERIFY=y
# CONFIG_SIGNED_IMAGES is not set
# CONFIG_SIGALG_RAWRSA is not set
CONFIG_LIBCONFIG=y
CONFIG_RAW=y
CONFIG_GUNZIP=y
# CONFIG_WEBSERVER is not set
# CONFIG_SURICATTA is not set
# CONFIG_LUA is not set
# CONFIG_SCRIPTS is not set
