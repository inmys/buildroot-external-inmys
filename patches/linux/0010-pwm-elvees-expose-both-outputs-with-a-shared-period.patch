From: INMYS <support@inmys.ru>
Subject: [PATCH] pwm: elvees: expose both outputs with a shared period

Add an opt-in dual-output mode, exposing OUTA0..3 as indices 0..3 and
OUTB0..3 as indices 4..7. Give each output its own compare register and
continuous 0/100 percent forcing. Keep the shared counter running while
either output is enabled and reject conflicting periods before any MMIO
write. Preserve the existing four-channel interface by default.

This allows the NMS-SM-K1892VM21YA SoC fan on OUTA0 and LCD0 backlight
on OUTB0 to have independent duties at the same frequency. CTRRUN is a
global register; access it through channel zero for every timer.

Signed-off-by: INMYS <support@inmys.ru>
---
--- a/drivers/pwm/pwm-elvees.c
+++ b/drivers/pwm/pwm-elvees.c
@@ -9,6 +9,7 @@
 #include <linux/io.h>
 #include <linux/kernel.h>
 #include <linux/module.h>
+#include <linux/math64.h>
 #include <linux/platform_device.h>
 #include <linux/pwm.h>
 #include <linux/of.h>
@@ -21,10 +22,13 @@
 #define PWM_CLKCTL			0x08
 #define PWM_CTRPRD			0x10
 #define PWM_CTRCNT			0x14
+#define PWM_CMPCTL			0x20
 #define PWM_CMPA			0x24
+#define PWM_CMPB			0x28
 #define PWM_EMCTLA			0x2C
 #define PWM_EMCTLB			0x30
 #define PWM_EMSWFR			0x34
+#define PWM_EMCSWFR			0x38
 #define PWM_CTRRUN			0x80
 
 #define PWM_CLKCTL_CNTMODE(v)		((v) << 0)
@@ -83,6 +87,9 @@
 	void __iomem *mmio_base;
 	u32 out_channel[NUM_PWM_CHANNEL]; /* 0 == OUTA, >0 == OUTB */
 	u32 state_on_disable[NUM_PWM_CHANNEL];
+	bool dual_output;
+	u32 enabled_mask;
+	u32 period_ticks[NUM_PWM_CHANNEL];
 };
 
 static inline void elvees_pwm_writel(struct elvees_pwm_chip *chip,
@@ -96,10 +103,92 @@
 	return readl(chip->mmio_base + reg + port * PWM_DEVICE_OFFSET);
 }
 
+/* Dual-output numbering: 0..3 are OUTA0..3, 4..7 are OUTB0..3. */
+static int elvees_pwm_apply_dual(struct pwm_chip *chip, struct pwm_device *pwm,
+				 const struct pwm_state *state)
+{
+	struct elvees_pwm_chip *priv = pwmchip_get_drvdata(chip);
+	u32 port = pwm->hwpwm % NUM_PWM_CHANNEL;
+	bool out_b = pwm->hwpwm >= NUM_PWM_CHANNEL;
+	u32 peer = BIT(out_b ? port : port + NUM_PWM_CHANNEL);
+	u32 event_reg = out_b ? PWM_EMCTLB : PWM_EMCTLA;
+	u32 force_shift = out_b ? 2 : 0;
+	u32 force, events = 0, run, ticks = 0, duty = 0;
+	u32 active = state->polarity == PWM_POLARITY_NORMAL ?
+		PWM_EMCTL_ACTION_SET : PWM_EMCTL_ACTION_CLEAR;
+	u32 inactive = state->polarity == PWM_POLARITY_NORMAL ?
+		PWM_EMCTL_ACTION_CLEAR : PWM_EMCTL_ACTION_SET;
+	u64 rate = clk_get_rate(priv->clk), period;
+
+	if (state->enabled) {
+		if (!rate || state->period >
+		    div64_u64((u64)U32_MAX * NSEC_PER_SEC, rate))
+			return -ERANGE;
+		period = DIV_ROUND_CLOSEST_ULL(rate * state->period, NSEC_PER_SEC);
+		if (period < 2 || period > U32_MAX)
+			return -ERANGE;
+		ticks = period;
+
+		/* Reject a conflicting period before touching either output. */
+		if ((priv->enabled_mask & peer) && priv->period_ticks[port] != ticks)
+			return -EBUSY;
+
+		duty = DIV_ROUND_CLOSEST_ULL(rate * state->duty_cycle, NSEC_PER_SEC);
+	}
+
+	if (state->enabled && !(priv->enabled_mask & peer)) {
+		elvees_pwm_writel(priv, PWM_CLKCTL,
+				  PWM_CLKCTL_CNTMODE(PWM_CNTMODE_DOWN) |
+				  PWM_CLKCTL_LOADPRD(PWM_LOADPRD_DISABLE) |
+				  PWM_CLKCTL_SYNCOSEL(PWM_SYNCOSEL_DISABLE), port);
+		/* Load CMPA and CMPB at zero, avoiding truncated duty updates. */
+		elvees_pwm_writel(priv, PWM_CMPCTL, 0, port);
+		elvees_pwm_writel(priv, PWM_CTRPRD, ticks - 1, port);
+		priv->period_ticks[port] = ticks;
+	}
+
+	/* Constant levels also handle exact 0%/100% without narrow glitches. */
+	force = inactive;
+	if (state->enabled && duty == ticks) {
+		force = active;
+	} else if (state->enabled && state->duty_cycle) {
+		force = 0;
+		duty = clamp(duty, 1U, ticks - 1);
+		elvees_pwm_writel(priv, out_b ? PWM_CMPB : PWM_CMPA, duty, port);
+		events = PWM_EMCTLA_EPRD(inactive);
+		events |= out_b ? PWM_EMCTLA_ECMPBD(active) : PWM_EMCTLA_ECMPAD(active);
+	}
+	elvees_pwm_writel(priv, event_reg, events, port);
+
+	/* Direct continuous forcing; preserve the other output's setting. */
+	run = elvees_pwm_readl(priv, PWM_EMSWFR, port);
+	elvees_pwm_writel(priv, PWM_EMSWFR, run | (3U << 6), port);
+	run = elvees_pwm_readl(priv, PWM_EMCSWFR, port);
+	run = (run & ~(3U << force_shift)) | (force << force_shift);
+	elvees_pwm_writel(priv, PWM_EMCSWFR, run, port);
+
+	if (state->enabled)
+		priv->enabled_mask |= BIT(pwm->hwpwm);
+	else
+		priv->enabled_mask &= ~BIT(pwm->hwpwm);
+
+	/* CTRRUN is global. Only stop a counter when both its outputs are off. */
+	run = elvees_pwm_readl(priv, PWM_CTRRUN, 0);
+	run &= ~PWM_CTRRUN_RUN(port, PWM_RUN_MASK);
+	if (priv->enabled_mask & (BIT(port) | BIT(port + NUM_PWM_CHANNEL)))
+		run |= PWM_CTRRUN_RUN(port, PWM_RUN_START);
+	elvees_pwm_writel(priv, PWM_CTRRUN, run, 0);
+
+	return 0;
+}
+
 static int elvees_pwm_request(struct pwm_chip *chip, struct pwm_device *pwm)
 {
 	struct elvees_pwm_chip *pwm_chip = pwmchip_get_drvdata(chip);
 	u32 val;
+
+	if (pwm_chip->dual_output)
+		return 0;
 
 	elvees_pwm_writel(pwm_chip, pwm_chip->out_channel[pwm->hwpwm] ?
 			PWM_EMCTLB : PWM_EMCTLA,
@@ -201,8 +290,12 @@
 static int elvees_pwm_apply(struct pwm_chip *chip, struct pwm_device *pwm,
 			    const struct pwm_state *state)
 {
+	struct elvees_pwm_chip *priv = pwmchip_get_drvdata(chip);
 	int err;
 	bool enabled = pwm->state.enabled;
+
+	if (priv->dual_output)
+		return elvees_pwm_apply_dual(chip, pwm, state);
 
 	if (state->polarity != pwm->state.polarity) {
 		if (enabled) {
@@ -244,6 +337,9 @@
 	int ret;
 	struct elvees_pwm_chip *elvees_pwm_chip = pwmchip_get_drvdata(pwm_chip);
 
+	if (elvees_pwm_chip->dual_output)
+		return 0;
+
 	ret = of_property_read_u32_array(node, "elvees,output-channel",
 				   elvees_pwm_chip->out_channel, NUM_PWM_CHANNEL);
 	if (ret < 0)
@@ -261,13 +357,16 @@
 {
 	struct elvees_pwm_chip *elvees_pwm_chip;
 	struct pwm_chip *chip;
+	bool dual_output = of_property_read_bool(pdev->dev.of_node, "elvees,dual-output");
 	int ret;
 
-	chip = devm_pwmchip_alloc(&pdev->dev, NUM_PWM_CHANNEL, sizeof(*elvees_pwm_chip));
+	chip = devm_pwmchip_alloc(&pdev->dev, dual_output ? 2 * NUM_PWM_CHANNEL :
+				 NUM_PWM_CHANNEL, sizeof(*elvees_pwm_chip));
 
 	if (IS_ERR(chip))
 		return PTR_ERR(chip);
 	elvees_pwm_chip = pwmchip_get_drvdata(chip);
+	elvees_pwm_chip->dual_output = dual_output;
 
 
 	elvees_pwm_chip->mmio_base = devm_platform_ioremap_resource(pdev, 0);
