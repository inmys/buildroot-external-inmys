diff -urN a/arch/arm64/boot/dts/elvees/nms-itx-sm-lc-v4.dts b/arch/arm64/boot/dts/elvees/nms-itx-sm-lc-v4.dts
--- a/arch/arm64/boot/dts/elvees/nms-itx-sm-lc-v4.dts
+++ b/arch/arm64/boot/dts/elvees/nms-itx-sm-lc-v4.dts
@@ -0,0 +1,99 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * NMS-ITX-SM-LC-V4 - mini-ITX SMARC carrier
+ *
+ * The carrier provides: 2 x GbE, HDMI, DP (via DP-to-VGA), DSI/LVDS,
+ * M.2 SATA, CAN (buffered to UART), I2S audio, fan control, I2C GPIO
+ * expander and an EEPROM with the carrier ID.
+ *
+ * Only the bring-up relevant part is described here; the rest is added
+ * as it gets validated on hardware.
+ *
+ * Copyright (C) 2026 INMYS
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+
+#include "nms-sm-k1892vm21ya.dtsi"
+
+/ {
+	model = "INMYS NMS-SM-K1892VM21YA V1 on NMS-ITX-SM-LC-V4";
+	compatible = "inmys,nms-itx-sm-lc-v4",
+		     "inmys,nms-sm-k1892vm21ya",
+		     "inmys,nms-sm-k1892",
+		     "elvees,mcom03r";
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	aliases {
+		ethernet0 = &emac0;
+		ethernet1 = &emac1;
+	};
+};
+
+/* SER0 console header */
+&uart3 {
+	status = "okay";
+};
+
+&uart0 {
+	status = "okay";
+};
+
+/* SD card slot */
+&sdhci0 {
+	status = "okay";
+};
+
+/* 2 x GbE */
+&emac0 {
+	status = "okay";
+	phy-handle = <&ethernet_phy0>;
+};
+
+&emac1 {
+	status = "okay";
+	phy-handle = <&ethernet_phy1>;
+};
+
+/* USB */
+&usb0 {
+	status = "okay";
+};
+
+&usb1 {
+	status = "okay";
+};
+
+/* PCIe / M.2 SATA */
+&pcie0 {
+	status = "okay";
+	reset-gpios = <&gpio0b 4 GPIO_ACTIVE_LOW>;
+};
+
+/* HDMI */
+&adv7513 {
+	status = "okay";
+};
+
+&de_dpi {
+	status = "okay";
+};
+
+/* DSI -> LVDS panel */
+&de_dsi {
+	status = "okay";
+};
+
+/* CAN (buffered) */
+&mfbsp0_can {
+	status = "okay";
+};
+
+&mfbsp1_can {
+	status = "okay";
+};
diff -urN a/arch/arm64/boot/dts/elvees/nms-smarc-tester.dts b/arch/arm64/boot/dts/elvees/nms-smarc-tester.dts
--- a/arch/arm64/boot/dts/elvees/nms-smarc-tester.dts
+++ b/arch/arm64/boot/dts/elvees/nms-smarc-tester.dts
@@ -0,0 +1,92 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * NMS_SMARC_TESTER V1 - SMARC test/burn-in carrier
+ *
+ * The tester is a multi-purpose bring-up board (Ethernet, HDMI/DP,
+ * LVDS/eDP converter, M.2 SATA/WiFi, USB, CAN, SD, FPGA GPIO...).
+ * Only the resources needed for bring-up are described here; the
+ * remaining peripherals are added as they are validated.
+ *
+ * Copyright (C) 2026 INMYS
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+
+#include "nms-sm-k1892vm21ya.dtsi"
+
+/ {
+	model = "INMYS NMS-SM-K1892VM21YA V1 on NMS_SMARC_TESTER V1";
+	compatible = "inmys,nms-smarc-tester",
+		     "inmys,nms-sm-k1892vm21ya",
+		     "inmys,nms-sm-k1892",
+		     "elvees,mcom03r";
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	aliases {
+		ethernet0 = &emac0;
+		ethernet1 = &emac1;
+	};
+};
+
+/* SER0 console (RS-232/USB-UART on the tester) */
+&uart3 {
+	status = "okay";
+};
+
+&uart0 {
+	status = "okay";
+};
+
+/* microSD / SDIO socket on the tester */
+&sdhci0 {
+	status = "okay";
+};
+
+/* Ethernet (1000BASE-T magnetics + RJ45) */
+&emac0 {
+	status = "okay";
+	phy-handle = <&ethernet_phy0>;
+};
+
+&emac1 {
+	status = "okay";
+	phy-handle = <&ethernet_phy1>;
+};
+
+/* USB host ports (module hub) and USB-SATA bridge */
+&usb0 {
+	status = "okay";
+};
+
+&usb1 {
+	status = "okay";
+};
+
+/* PCIe slot / M.2 */
+&pcie0 {
+	status = "okay";
+	reset-gpios = <&gpio0b 4 GPIO_ACTIVE_LOW>;
+};
+
+/* HDMI/DP test path */
+&adv7513 {
+	status = "okay";
+};
+
+&de_dpi {
+	status = "okay";
+};
+
+/* CAN bus connectors */
+&mfbsp0_can {
+	status = "okay";
+};
+
+&mfbsp1_can {
+	status = "okay";
+};
diff -urN a/arch/arm64/boot/dts/elvees/nms-sm-elvsmarccb.dts b/arch/arm64/boot/dts/elvees/nms-sm-elvsmarccb.dts
--- a/arch/arm64/boot/dts/elvees/nms-sm-elvsmarccb.dts
+++ b/arch/arm64/boot/dts/elvees/nms-sm-elvsmarccb.dts
@@ -0,0 +1,202 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * INMYS NMS-SM-K1892VM21YA V1 on ELV-SMARC-CB r3.3.0
+ *
+ * The ELV-SMARC-CB is the ELVEES reference SMARC carrier: 2x GbE, HDMI out,
+ * LVDS/eDP, audio codec, 2x CAN, PCIe x4 + miniPCIe, USB, microSD.
+ * Only the resources needed for bring-up are described here; the remaining
+ * peripherals are added as they are validated.
+ *
+ * Copyright (C) 2026 INMYS
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/clock/mcom03-clock.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/pwm/pwm.h>
+
+#include "nms-sm-k1892vm21ya.dtsi"
+
+/ {
+	model = "INMYS NMS-SM-K1892VM21YA V1 on ELV-SMARC-CB r3.3.0";
+	compatible = "inmys,nms-sm-elvsmarccb",
+		     "inmys,nms-sm-k1892vm21ya",
+		     "inmys,nms-sm-k1892",
+		     "elvees,mcom03r";
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	aliases {
+		ethernet0 = &emac0;
+		ethernet1 = &emac1;
+	};
+
+	/* HDMI receptacle on the carrier, fed from the module's ADV7513 */
+	hdmi_connector: hdmi-connector {
+		compatible = "hdmi-connector";
+		label = "hdmi";
+		type = "a";
+
+		port {
+			hdmi_connector_in: endpoint {
+				remote-endpoint = <&adv7513_out>;
+			};
+		};
+	};
+
+	/* XP6 backlight connector, enabled by LCD0_BKLT_EN (expander P0_0) */
+	backlight: backlight {
+		compatible = "pwm-backlight";
+		pwms = <&timers_pwm 1 2000000 PWM_POLARITY_INVERTED>;
+		enable-gpios = <&gpio_expander 0 GPIO_ACTIVE_HIGH>;
+		brightness-levels = <100 90 80 70 60 50 40 30 20 10 1 0>;
+		default-brightness-level = <10>;
+		status = "disabled";
+	};
+};
+
+/* SER1_DBG, USB Type-C debug UART */
+&uart0 {
+	status = "okay";
+};
+
+&uart3 {
+	status = "okay";
+};
+
+/*
+ * microSD socket XS6 (SDIO).  3.3 V only; the clock pad drive strength has
+ * to be raised on this PCB, as in the ELVEES reference device tree.
+ */
+&sdhci0 {
+	status = "okay";
+	sdhci-caps-mask = <0x7 0x4000000>;
+	sdhci-caps = <0x0 0x0>;
+	elvees,drive-strength-clk = <6>;
+
+	/*
+	 * SDHCI 3.0 only allows even clock dividers, so with the 125 MHz base
+	 * clock a 50 MHz request becomes 125/4 = 31.25 MHz (125/2 = 62.5 MHz
+	 * is too fast).  Dropping the base clock to 100 MHz makes divider 2
+	 * land exactly on 50 MHz.
+	 */
+	assigned-clocks = <&hsperiph_clocks CLK_HSP_UCG1_SDMMC0_XIN>;
+	assigned-clock-rates = <100000000>;
+};
+
+/* Ethernet (RJ45 XS2/XS3) */
+&emac0 {
+	status = "okay";
+	phy-handle = <&ethernet_phy0>;
+};
+
+&emac1 {
+	status = "okay";
+	phy-handle = <&ethernet_phy1>;
+};
+
+&usb0 {
+	status = "okay";
+};
+
+&usb1 {
+	status = "okay";
+};
+
+/*
+ * QSPI1 flash socket XS7 (SOIC-8, ACA-SPI-004), powered from 1V8_SF-0 and
+ * routed through the module's RS2299 crossbar D31/D32.  The crossbar is
+ * selected by QSPI_SPI# = PCAL6416A P0_4: 1 = QSPI1, 0 = SPI1.  U-Boot sets
+ * it before probing the socket; the kernel only has to keep the pads in
+ * 1.8 V mode, which is what qspi1_default_18 does.
+ */
+&qspi1 {
+	status = "okay";
+	pinctrl-0 = <&qspi1_default_18>;
+
+	qspi_flash: spi-nor@0 {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		compatible = "jedec,spi-nor", "spi-flash";
+		reg = <0x0>;
+		/* Highest frequency for the IC installed into the socket */
+		spi-max-frequency = <3000000>;
+		m25p,fast-read;
+	};
+};
+
+&qspi1_default {
+	/*
+	 * Max clock frequency is 1 MHz with the default pad drive strength;
+	 * this raises it to 3 MHz.
+	 */
+	clk {
+		drive-strength = <10>;
+	};
+};
+
+/* PCIe x4 slot and miniPCIe */
+&pcie0 {
+	status = "okay";
+};
+
+/* ------------------------------------------------------------------ */
+/* Display                                                            */
+/* ------------------------------------------------------------------ */
+
+/*
+ * Both display bridges sit on the module (D19 ADV7513 for HDMI, D10
+ * SN65DSI84 for LVDS); the carrier only routes the SMARC HDMI and LVDS pins
+ * to its receptacles, so nothing but the connector and the panel has to be
+ * described here.
+ */
+&dp {
+	status = "okay";
+};
+
+/* Parallel RGB path: Mali-DP -> DPI -> ADV7513 -> HDMI receptacle */
+&de_dpi {
+	status = "okay";
+};
+
+&adv7513 {
+	status = "okay";
+
+	ports {
+		port@1 {
+			reg = <1>;
+
+			adv7513_out: endpoint {
+				remote-endpoint = <&hdmi_connector_in>;
+			};
+		};
+	};
+};
+
+/* MIPI DSI path: Mali-DP -> DSI -> SN65DSI84 -> LVDS panel on XP7 */
+&de_dsi {
+	status = "okay";
+};
+
+&lvds_bridge {
+	status = "okay";
+};
+
+&lvds_panel {
+	status = "okay";
+	backlight = <&backlight>;
+};
+
+&timers_pwm {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&timer1_toggle_mux>;
+};
+
+&backlight {
+	status = "okay";
+};
+
diff -urN a/arch/arm64/boot/dts/elvees/nms-sm-evm.dts b/arch/arm64/boot/dts/elvees/nms-sm-evm.dts
--- a/arch/arm64/boot/dts/elvees/nms-sm-evm.dts
+++ b/arch/arm64/boot/dts/elvees/nms-sm-evm.dts
@@ -0,0 +1,172 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * INMYS NMS-SM-EVM V1 - default carrier board for NMS-SM-K1892VM21YA
+ *
+ * Carrier resources (see HARDWARE.md):
+ *   X6   SMARC 2.1 edge connector (314 pin, AS0B826-S78B-7H)
+ *   X5   microSD socket                       (module SDMMC0)
+ *   X7   RJ45 GbE0, X8 RJ45 GbE1              (module DAP8211 PHYs)
+ *   X4   HDMI type A via TPD12S016 (D1)       (module ADV7513)
+ *   X23  DisplayPort                          (module DP)
+ *   X33  PCIe x4 slot                         (module PCIe0)
+ *   X19  miniPCIe                             (module PCIe1)
+ *   X9   M.2 M-key (SATA via module TUSB9261)
+ *   X10/X11 USB 3.0 / USB 2.0 host ports      (module TUSB8041 hub)
+ *   X24/X25 30-pin FPC DSI0/DSI1 displays + touch
+ *   X13..X16 CAN0/CAN1 terminals              (module MFBSP0/1)
+ *   X34  fan connector + D32 ADT7473 fan controller
+ *   D31  PCA9535 GPIO expander (I2C_PM)
+ *   D30  PCA9546 I2C switch (I2C_GP -> GP_A / mPCIe / DSI0 / DSI1)
+ *
+ * Copyright (C) 2026 INMYS
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+
+#include "nms-sm-k1892vm21ya.dtsi"
+
+/ {
+	model = "INMYS NMS-SM-K1892VM21YA V1 on NMS-SM-EVM V1";
+	compatible = "inmys,nms-sm-evm",
+		     "inmys,nms-sm-k1892vm21ya",
+		     "inmys,nms-sm-k1892",
+		     "elvees,mcom03r";
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	aliases {
+		ethernet0 = &emac0;
+		ethernet1 = &emac1;
+	};
+
+	hdmi_connector: hdmi-connector {
+		compatible = "hdmi-connector";
+		label = "hdmi";
+		type = "a";
+
+		port {
+			hdmi_connector_in: endpoint {
+				remote-endpoint = <&adv7513_out>;
+			};
+		};
+	};
+};
+
+/* ------------------------------------------------------------------ */
+/* Console: SER0 (UART3, RS-232 transceiver on the carrier)           */
+/* ------------------------------------------------------------------ */
+
+&uart3 {
+	status = "okay";
+};
+
+/* SER1_DBG (UART0 via the D33 crossbar) is the debug console */
+&uart0 {
+	status = "okay";
+};
+
+/* ------------------------------------------------------------------ */
+/* Carrier I2C devices                                                */
+/* ------------------------------------------------------------------ */
+
+/* I2C_PM: PCA9535 (D31) */
+&i2c0 {
+	status = "okay";
+	clock-frequency = <100000>;
+
+	carrier_gpio: gpio@20 {
+		compatible = "nxp,pca9535";
+		reg = <0x20>;
+		gpio-controller;
+		#gpio-cells = <2>;
+
+		gpio-line-names =
+			"DSI0_TP_RST_N", "DSI1_TP_RST_N",
+			"DSI0_RST_N", "DSI1_RST_N",
+			"CAM0_PWDN#", "I2C_GPIO05",
+			"I2C_GPIO06", "I2C_GPIO07",
+			"I2C_GPIO10", "I2C_GPIO11",
+			"I2C_GPIO12", "I2C_GPIO13",
+			"I2C_GPIO14", "I2C_GPIO15",
+			"I2C_GPIO16", "I2C_GPIO17";
+	};
+};
+
+/* I2C_GP: fan controller (D32) and I2C switch (D30) */
+&i2c1 {
+	status = "okay";
+	clock-frequency = <100000>;
+
+	/* ADT7473ARQZ fan controller, 7-bit address 0x2e */
+	fan_controller: hwmon@2e {
+		compatible = "adi,adt7473";
+		reg = <0x2e>;
+	};
+
+	i2c_gp_switch: i2c-switch@70 {
+		compatible = "nxp,pca9546";
+		reg = <0x70>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		i2c_gp_a: i2c@0 {
+			#address-cells = <1>;
+			#size-cells = <0>;
+			reg = <0>;
+		};
+
+		i2c_mpcie: i2c@1 {
+			#address-cells = <1>;
+			#size-cells = <0>;
+			reg = <1>;
+		};
+
+		i2c_dsi0: i2c@2 {
+			#address-cells = <1>;
+			#size-cells = <0>;
+			reg = <2>;
+		};
+
+		i2c_dsi1: i2c@3 {
+			#address-cells = <1>;
+			#size-cells = <0>;
+			reg = <3>;
+		};
+	};
+};
+
+/* i2c_gp_a: X32 "PLD-10" expansion header */
+/* i2c_mpcie: miniPCIe socket X19 */
+
+/* ------------------------------------------------------------------ */
+/* HDMI (X4) - ADV7513 is on the module, TPD12S016 on the carrier     */
+/* ------------------------------------------------------------------ */
+
+&adv7513 {
+	status = "okay";
+
+	ports {
+		port@1 {
+			reg = <1>;
+
+			adv7513_out: endpoint {
+				remote-endpoint = <&hdmi_connector_in>;
+			};
+		};
+	};
+};
+
+/* ------------------------------------------------------------------ */
+/* PCIe (X33 x4 slot on PCIe0, X19 miniPCIe on PCIe1)                 */
+/* ------------------------------------------------------------------ */
+
+&pcie0 {
+	status = "okay";
+	reset-gpios = <&gpio0b 4 GPIO_ACTIVE_LOW>;
+};
+
diff -urN a/arch/arm64/boot/dts/elvees/nms-sm-k1892vm21ya.dtsi b/arch/arm64/boot/dts/elvees/nms-sm-k1892vm21ya.dtsi
--- a/arch/arm64/boot/dts/elvees/nms-sm-k1892vm21ya.dtsi
+++ b/arch/arm64/boot/dts/elvees/nms-sm-k1892vm21ya.dtsi
@@ -0,0 +1,756 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * INMYS NMS-SM-K1892VM21YA V1
+ * SMARC 2.1 module on ELVEES MCom-03R (К1892ВМ21Я)
+ *
+ * Module resources (see HARDWARE.md in the SDK root for the full map):
+ *   SoC            К1892ВМ21Я (MCom-03R), BGA-1936
+ *   LPDDR4         D27/D28 Rayson RS512M32LO4D1BDS-46IT, 2 x 2 GiB,
+ *                  DDRMC0 (MEMA/MEMB) + DDRMC1 (MEMC/MEMD), 2133 MT/s
+ *   eMMC           D20 Kioxia THGAMRG7T13BAIL 16 GiB  -> SDMMC1 (8 bit)
+ *   SD/SDIO        SMARC SDIO (4 bit)                 -> SDMMC0
+ *   QSPI boot      D21 W25Q128FWPIG 16 MiB            -> QSPI0
+ *   RTC            D8  PCF8523TK                      -> I2C_INT_1V8
+ *   GPIO expander  D34 PCAL6416AHF                    -> I2C_INT_1V8
+ *   I2C mux        D30 PCA9540BGD (I2C_INT / I2C_INT_1V8)
+ *                  D29 PCA9546ABS (CAM0 / CAM1 / LCD)
+ *   Ethernet       D9A/D9B DAP8211RI (RGMII0/RGMII1, MDIO0/MDIO1)
+ *   USB hub        D14 TUSB8041IRGCR  (USB0 -> 4 ports)
+ *   USB-SATA       D16 TUSB9261IPVP   (USB1 -> SATA)
+ *   HDMI           D19 ADV7513BSWZ    (parallel RGB from DPI)
+ *   LVDS           D10 SN65DSI84ZQER  (DSI -> 2 x LVDS)
+ *   Board ctrl     D41 STM32L052C8T6  (power/reset/bootsel sequencing)
+ *
+ * Copyright (C) 2026 INMYS
+ */
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/leds/common.h>
+
+#include "mcom03r.dtsi"
+
+/ {
+	model = "INMYS NMS-SM-K1892VM21YA V1";
+	compatible = "inmys,nms-sm-k1892vm21ya",
+		     "inmys,nms-sm-k1892",
+		     "elvees,mcom03r";
+
+	aliases {
+		i2c_pm = &i2c0;
+		i2c_gp = &i2c1;
+		i2c5 = &i2c_cam0;
+		i2c6 = &i2c_cam1;
+		i2c7 = &i2c_lcd;
+		mmc0 = &sdhci0;
+		mmc1 = &sdhci1;
+	};
+
+	/* eMMC is 1.8 V only on this module */
+	emmc_1v8: regulator-emmc-1v8 {
+		compatible = "regulator-fixed";
+		regulator-name = "emmc-1v8";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		regulator-always-on;
+	};
+
+	/* SDIO level shifter (SDMMC0_18EN) is controlled by the SoC itself,
+	 * the SMARC SDIO rail is 3.3 V by default.
+	 */
+	sdio_3v3: regulator-sdio-3v3 {
+		compatible = "regulator-fixed";
+		regulator-name = "sdio-3v3";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		regulator-always-on;
+	};
+
+	/* 1.8 V I2C_INT rail used by RTC, GPIO expander and video bridges */
+	i2c_int_1v8: regulator-i2c-int-1v8 {
+		compatible = "regulator-fixed";
+		regulator-name = "i2c-int-1v8";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		regulator-always-on;
+	};
+
+	hdmi_1v8: regulator-hdmi-1v8 {
+		compatible = "regulator-fixed";
+		regulator-name = "hdmi-1v8";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		regulator-always-on;
+	};
+
+	hdmi_3v3: regulator-hdmi-3v3 {
+		compatible = "regulator-fixed";
+		regulator-name = "hdmi-3v3";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		regulator-always-on;
+	};
+
+	lvds_1v8: regulator-lvds-1v8 {
+		compatible = "regulator-fixed";
+		regulator-name = "lvds-1v8";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		regulator-always-on;
+	};
+
+	/*
+	 * LVDS panel on the carrier (XP7 on the ELV-SMARC-CB).  It is declared
+	 * here, disabled, only so that the SN65DSI84 output endpoint resolves
+	 * for every carrier device tree.  The timing is a placeholder - replace
+	 * it with the data of the panel actually plugged in, otherwise the
+	 * picture will be wrong even though the pipeline probes cleanly.
+	 */
+	lvds_panel: panel-lvds {
+		compatible = "panel-lvds";
+		status = "disabled";
+		width-mm = <217>;
+		height-mm = <136>;
+		data-mapping = "jeida-24";
+
+		panel-timing {
+			clock-frequency = <71000000>;
+			hactive = <1280>;
+			vactive = <800>;
+			hfront-porch = <40>;
+			hback-porch = <40>;
+			hsync-len = <48>;
+			vfront-porch = <3>;
+			vback-porch = <10>;
+			vsync-len = <6>;
+		};
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+				panel_in_a: endpoint {
+					remote-endpoint = <&lvds_out_a>;
+				};
+			};
+		};
+	};
+};
+
+&uart0 {
+	status = "okay";
+};
+
+&uart1 {
+	status = "okay";
+};
+
+&uart2 {
+	status = "okay";
+};
+
+&uart3 {
+	status = "okay";
+};
+
+/*
+ * SMARC serial ports.
+ *
+ * SER0 (P129/P130 + RTS/CTS P131/P132) is wired directly to UART3,
+ * SER1_DBG (P134/P135) goes through the RS2299 crossbar D33 which selects
+ * between UART0 (RISC0 console) and UART1, SER2 (P136/P137) is UART2 and
+ * SER3 (P140/P141) is UART1.
+ *
+ * The crossbar is controlled by UART_0_1_CROSS# (GPIO1_PORTA_6).  It is
+ * pulled high on the module, which is the "UART0 on SER1_DBG" position
+ * used by the ELVEES SMARC convention, so the console is ttyS0 (UART0).
+ */
+ser0: &uart3 { };
+ser1: &uart0 { };
+ser2: &uart2 { };
+ser3: &uart1 { };
+
+/* ------------------------------------------------------------------ */
+/* Storage                                                            */
+/* ------------------------------------------------------------------ */
+
+/* eMMC (D20, BGA-153, HS200/HS400) */
+&sdhci1 {
+	status = "okay";
+
+	non-removable;
+	bus-width = <8>;
+	mmc-hs200-1_8v;
+	vqmmc-supply = <&emmc_1v8>;
+};
+
+/* SMARC SDIO (4 bit). CD# and WP come from dedicated SoC pins. */
+/* SMARC SDIO (4 bit, 3.3 V only) */
+&sdhci0 {
+	status = "okay";
+
+	bus-width = <4>;
+	vmmc-supply = <&sdio_3v3>;
+	vqmmc-supply = <&sdio_3v3>;
+	no-1-8-v;
+	/*
+	 * SDMMC0_CDN (ball BB1) -> SMARC SDIO_CD# (P35), pull-up R46 on the
+	 * module, socket switch XS6.9 on the carrier.  The controller reports
+	 * it in Present State bit 16 (CARD_INSERTED): measured 0 with an empty
+	 * slot and 1 when CDTL is forced high, so the pin works and the driver
+	 * can use it as-is.
+	 *
+	 * Do NOT add broken-cd here.  It sets MMC_CAP_NEEDS_POLL, and with an
+	 * empty slot that re-probes every 10 s forever:
+	 *   mmc0: Timeout waiting for hardware cmd interrupt.
+	 * It was a workaround for the first (defective) board and is not
+	 * needed on a working one.
+	 */
+};
+
+/* Boot SPI flash (D21 W25Q128FWPIG, 16 MiB, 4 bit) */
+&qspi0 {
+	status = "okay";
+
+	flash0: flash@0 {
+		compatible = "jedec,spi-nor", "spi-flash";
+		reg = <0x0>;
+		spi-max-frequency = <66000000>;
+		spi-tx-bus-width = <4>;
+		spi-rx-bus-width = <4>;
+		m25p,fast-read;
+
+		/*
+		 * Layout used by the ELVEES boot chain (see the
+		 * package.toml inside the SBL *.tl-image):
+		 *
+		 *   0x000000  BootROM SBIMG (sbl-s1 + ddrinit + sbl-s2)
+		 *   0x200000  SBL image slot A (bl31 + u-boot + dtb + sbl-s3)
+		 *   0x600000  SBL image slot B (update slot)
+		 *   0xFE0000  U-Boot environment (CONFIG_ENV_OFFSET)
+		 */
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "bootrom";
+				reg = <0x000000 0x200000>;
+			};
+
+			partition@200000 {
+				label = "sbl-a";
+				reg = <0x200000 0x400000>;
+			};
+
+			partition@600000 {
+				label = "sbl-b";
+				reg = <0x600000 0x400000>;
+			};
+
+			partition@a00000 {
+				label = "spare";
+				reg = <0xA00000 0x5E0000>;
+			};
+
+			partition@fe0000 {
+				label = "uboot-env";
+				reg = <0xFE0000 0x010000>;
+			};
+
+			partition@ff0000 {
+				label = "spare2";
+				reg = <0xFF0000 0x010000>;
+			};
+		};
+	};
+};
+
+/* ------------------------------------------------------------------ */
+/* I2C                                                                */
+/* ------------------------------------------------------------------ */
+
+/* SMARC I2C_PM (SoC I2C0) - power management bus, 3.3 V */
+&i2c0 {
+	status = "okay";
+	clock-frequency = <100000>;
+};
+
+/* SMARC I2C_GP (SoC I2C1) - general purpose bus, 3.3 V */
+&i2c1 {
+	status = "okay";
+	clock-frequency = <100000>;
+};
+
+/* SoC I2C2 -> PCA9540B (D30): I2C_INT (3.3 V) and I2C_INT_1V8 */
+&i2c2 {
+	status = "okay";
+	clock-frequency = <100000>;
+
+	i2c_int_switch: i2c-switch@70 {
+		compatible = "nxp,pca9540";
+		reg = <0x70>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		/*
+		 * Channel 0 (I2C_INT, 3.3 V).  Verified from the U-Boot
+		 * prompt with `i2c mw 70 0.0 04` + `i2c probe`:
+		 *   0x2f EMC2301 fan controller (D35)
+		 *   0x44 TUSB8041 USB hub (D14), SMBus only, no driver
+		 */
+		i2c_int: i2c@0 {
+			#address-cells = <1>;
+			#size-cells = <0>;
+			reg = <0>;
+
+			fan: fan@2f {
+				compatible = "microchip,emc2301";
+				reg = <0x2f>;
+				#address-cells = <1>;
+				#size-cells = <0>;
+				#pwm-cells = <3>;
+			};
+		};
+
+		/*
+		 * Channel 1 (I2C_INT_1V8, 1.8 V).  Verified with
+		 * `i2c mw 70 0.0 05` + `i2c probe`:
+		 *   0x20 PCAL6416A GPIO expander (D34)
+		 *   0x2d SN65DSI84 DSI-LVDS bridge (D10)
+		 *   0x38/0x39/0x3c/0x3e/0x3f ADV7513 HDMI (D19)
+		 *   0x50/0x53 24AA025E48 EEPROMs (D11/D12), both blank
+		 *   0x68 PCF8523 RTC (D8)
+		 *
+		 * The ADV7513 and the SN65DSI84 need full OF-graph video
+		 * bindings, so they are not described yet.
+		 */
+		i2c_int_1v8_bus: i2c@1 {
+			#address-cells = <1>;
+			#size-cells = <0>;
+			reg = <1>;
+
+			gpio_expander: gpio@20 {
+				compatible = "nxp,pcal6416";
+				reg = <0x20>;
+				gpio-controller;
+				#gpio-cells = <2>;
+				interrupt-controller;
+				#interrupt-cells = <2>;
+				interrupt-parent = <&gpio0a>;
+				interrupts = <3 IRQ_TYPE_LEVEL_LOW>;
+			};
+
+			/*
+			 * Factory MAC addresses.  24AA025E48 EUI-48 EEPROMs
+			 * (D11/D12, SOT-23-6), 2 Kbit, 16-byte pages, 1-byte
+			 * register address.  The MAC sits in the last six
+			 * bytes of the array (0xfa..0xff) and the rest of
+			 * the array is blank.  U-Boot passes the addresses
+			 * to the kernel through /aliases, so these cells are
+			 * only a fallback for the case where the U-Boot
+			 * environment has been wiped.
+			 */
+			eeprom@50 {
+				compatible = "atmel,24c02";
+				reg = <0x50>;
+				pagesize = <16>;
+				#address-cells = <1>;
+				#size-cells = <1>;
+
+				mac0: mac-address@fa {
+					reg = <0xfa 0x6>;
+				};
+			};
+
+			eeprom@53 {
+				compatible = "atmel,24c02";
+				reg = <0x53>;
+				pagesize = <16>;
+				#address-cells = <1>;
+				#size-cells = <1>;
+
+				mac1: mac-address@fa {
+					reg = <0xfa 0x6>;
+				};
+			};
+
+		};
+	};
+};
+
+/* SoC I2C3 -> PCA9546A (D29): CAM0 / CAM1 / LCD */
+&i2c3 {
+	status = "okay";
+	clock-frequency = <100000>;
+
+	i2c_cam_switch: i2c-switch@77 {
+		compatible = "nxp,pca9546";
+		reg = <0x77>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		i2c_cam0: i2c@0 {
+			#address-cells = <1>;
+			#size-cells = <0>;
+			reg = <0>;
+		};
+
+		i2c_cam1: i2c@1 {
+			#address-cells = <1>;
+			#size-cells = <0>;
+			reg = <1>;
+		};
+
+		i2c_lcd: i2c@2 {
+			#address-cells = <1>;
+			#size-cells = <0>;
+			reg = <2>;
+		};
+	};
+};
+
+/* Devices on the 1.8 V branch of the PCA9540B */
+&i2c_int_1v8_bus {
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	/* RTC D8 */
+	rtc: rtc@68 {
+		compatible = "nxp,pcf8523";
+		reg = <0x68>;
+		/* RTC_INT# is routed to the board controller (D41), not to
+		 * the SoC, so it cannot be used as a wakeup source here.
+		 */
+	};
+
+	/* GPIO expander D34 */
+	gpio_expander: gpio@20 {
+		compatible = "nxp,pcal6416";
+		reg = <0x20>;
+		gpio-controller;
+		#gpio-cells = <2>;
+		interrupt-controller;
+		#interrupt-cells = <2>;
+		interrupt-parent = <&gpio0a>;
+		interrupts = <3 IRQ_TYPE_EDGE_FALLING>;
+
+		gpio-line-names =
+			"LCD0_BKLT_EN", "LCD0_VDD_EN",
+			"LCD1_BKLT_EN", "LCD1_VDD_EN",
+			"QSPI_SPI#", "BC_UART_SEL",
+			"PCIE_SEL", "HDMI_INT#",
+			"HDMI_PD", "EXP_P1_1",
+			"ENABLE_LVDS", "USB1_ID0_GPIO",
+			"BC_BOOT", "BC_RST",
+			"CAM_SEL0", "CAM_SEL1";
+	};
+
+	/*
+	 * HDMI transmitter D19 (parallel RGB in, HDMI out).
+	 *
+	 * Supplies, traced from the module netlist through the ferrite beads:
+	 *   AVDD_HDMI   D19.15/19/25 <- L30 <- +1V8_MEDIA
+	 *   HDMI_DVDD   D19.1/11/31/51 <- L29 <- +1V8_MEDIA
+	 *   HDMI_PVDD   D19.12/13 <- L28 <- +1V8_MEDIA
+	 *   HDMI_DVDD3V D19.29 <- L27 <- +3V3_CORE
+	 * The driver gets all five regulators in bulk, so every one of them has
+	 * to be named even though the rails themselves are always on.
+	 */
+	adv7513: hdmi@39 {
+		compatible = "adi,adv7513";
+		reg = <0x39>, <0x3f>;
+		reg-names = "main", "edid";
+		interrupt-parent = <&gpio_expander>;
+		interrupts = <7 IRQ_TYPE_EDGE_FALLING>;
+		/*
+		 * The binding says these three must be omitted in "rgb 1x" mode,
+		 * but adv7511_parse_dt() reads them unconditionally and returns
+		 * -EINVAL when they are missing (adi,clock-delay is read into an
+		 * uninitialised field, so leaving it out gives a random failure).
+		 */
+		adi,input-depth = <8>;
+		adi,input-colorspace = "rgb";
+		adi,input-clock = "1x";
+		adi,clock-delay = <0>;
+		powerdown-gpios = <&gpio_expander 8 GPIO_ACTIVE_LOW>;
+		avdd-supply = <&hdmi_1v8>;
+		dvdd-supply = <&hdmi_1v8>;
+		pvdd-supply = <&hdmi_1v8>;
+		dvdd-3v-supply = <&hdmi_3v3>;
+		bgvdd-supply = <&hdmi_1v8>;
+		#sound-dai-cells = <0>;
+		status = "disabled"; /* enable in carrier DTS when HDMI is used */
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+				adv7513_in: endpoint {
+					remote-endpoint = <&rgb_out>;
+				};
+			};
+		};
+	};
+
+	/*
+	 * DSI -> dual LVDS bridge D10 (SN65DSI84).
+	 *
+	 * The I2C address is 0x2d, not 0x2c: R82 pulls DSI_LVDS_ADDR (D10.A1)
+	 * up to +1V8_MEDIA.  A live `i2c probe` on I2C_INT_1V8 confirms 0x2d.
+	 * ENABLE_LVDS is PCAL6416A P1_2, i.e. line 10 of the expander.
+	 */
+	lvds_bridge: lvds-bridge@2d {
+		compatible = "ti,sn65dsi84";
+		reg = <0x2d>;
+		enable-gpios = <&gpio_expander 10 GPIO_ACTIVE_HIGH>;
+		vcc-supply = <&lvds_1v8>;
+		status = "disabled"; /* enable in carrier DTS when LVDS is used */
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			/* MIPI DSI channel A: all four lanes are wired */
+			port@0 {
+				reg = <0>;
+				lvds_in: endpoint {
+					remote-endpoint = <&dsi_out>;
+					data-lanes = <1 2 3 4>;
+				};
+			};
+
+			/* LVDS channel A -> panel */
+			port@2 {
+				reg = <2>;
+				lvds_out_a: endpoint {
+					remote-endpoint = <&panel_in_a>;
+				};
+			};
+		};
+	};
+};
+
+/*
+ * Display pipeline glue.  Mali-DP550 drives either the parallel RGB encoder
+ * (-> ADV7513 HDMI) or the MIPI DSI encoder (-> SN65DSI84 LVDS); both encoders
+ * need an output endpoint or their probe fails with -ENODEV and no DRM device
+ * is registered at all.
+ */
+&de_dpi {
+	ports {
+		port@1 {
+			reg = <1>;
+
+			rgb_out: endpoint {
+				remote-endpoint = <&adv7513_in>;
+			};
+		};
+	};
+};
+
+&de_dsi {
+	ports {
+		port@1 {
+			reg = <1>;
+
+			dsi_out: endpoint {
+				remote-endpoint = <&lvds_in>;
+			};
+		};
+	};
+};
+
+/* ------------------------------------------------------------------ */
+/* Ethernet                                                           */
+/* ------------------------------------------------------------------ */
+
+/*
+ * The PHYs (D9A/D9B, DAP8211) have their VDDIO on +1V8_AO and the RGMII
+ * nets are pulled to the same rail, so the SoC's EMAC pads must drive and
+ * sample at 1.8 V.  Without this the MAC transmits fine (the PHY still
+ * sees 3.3 V as high) but receives nothing at all: every hardware RX
+ * counter stays zero, because the PHY's 1.8 V levels never reach the
+ * 3.3 V input threshold.  `emac_v18` sets EMAC_V18 (URB 0x140, bit 0).
+ */
+&hsperiph_pinctrl {
+	pinctrl-0 = <&hsperiph_misc_default &emac_v18>;
+};
+
+/* D9A: RGMII0, MDIO0, PHY address 0 */
+&emac0 {
+	status = "okay";
+	phy-mode = "rgmii-id";
+	phy-handle = <&ethernet_phy0>;
+	nvmem-cells = <&mac0>;
+	nvmem-cell-names = "mac-address";
+
+	ethernet_phy0: ethernet-phy@0 {
+		compatible = "ethernet-phy-ieee802.3-c22";
+		reg = <0x0>;
+	};
+};
+
+/* D9B: RGMII1, MDIO1, PHY address 0 (separate MDIO bus) */
+&emac1 {
+	status = "okay";
+	phy-mode = "rgmii-id";
+	phy-handle = <&ethernet_phy1>;
+	nvmem-cells = <&mac1>;
+	nvmem-cell-names = "mac-address";
+
+	ethernet_phy1: ethernet-phy@0 {
+		compatible = "ethernet-phy-ieee802.3-c22";
+		reg = <0x0>;
+	};
+};
+
+/* ------------------------------------------------------------------ */
+/* USB                                                                */
+/* ------------------------------------------------------------------ */
+
+/* USB0 -> TUSB8041 hub (D14) -> 4 downstream ports on the carrier */
+&usb0 {
+	status = "okay";
+};
+
+/* USB1 -> TUSB9261 USB-SATA bridge (D16) */
+&usb1 {
+	status = "okay";
+};
+
+/* ------------------------------------------------------------------ */
+/* PCIe                                                               */
+/* ------------------------------------------------------------------ */
+
+/* PCIe0 is routed to the SMARC PCIe pins, PCIe1 to the second slot;
+ * the actual root complex used is selected by PCIE_SEL (expander P0_6).
+ */
+&pcie0 {
+	status = "okay";
+};
+
+/*
+ * pcie1 hangs the kernel during bus enumeration on every carrier we have
+ * tried: the last line printed is "pci 0001:00:00.0: PME# supported from
+ * D0 D1 D3hot" and nothing follows.  pcie0 enumerates fine and only says
+ * "Phy link never came up".  Keep pcie1 off until the root cause is found.
+ */
+&pcie1 {
+	status = "disabled";
+};
+
+/* ------------------------------------------------------------------ */
+/* CAN (MFBSP)                                                        */
+/* ------------------------------------------------------------------ */
+
+&mfbsp0_can {
+	status = "okay";
+};
+
+&mfbsp1_can {
+	status = "okay";
+};
+
+/* ------------------------------------------------------------------ */
+/* PWM (LCD backlight)                                                */
+/* ------------------------------------------------------------------ */
+
+&timers_pwm {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&timer1_toggle_mux>;
+};
+
+/* ------------------------------------------------------------------ */
+/* GPIO line names (SMARC naming)                                     */
+/* ------------------------------------------------------------------ */
+
+/*
+ * The names below are taken from the module netlist, ball by ball, not
+ * from the SMARC pin order -- the two differ for most of the SoC GPIOs.
+ * They are what "gpiofind" resolves, so /usr/sbin/nms-gpio.sh can drive
+ * the board multiplexers without knowing any chip or line number.
+ */
+
+&gpio0a {
+	gpio-line-names = "FORCE_RECOV#", "", "SER0_CTS", "I2C_GPIO_INT#",
+		"GPIO11", "GPIO12", "", "SER0_RTS";
+};
+
+&gpio0b {
+	gpio-line-names = "SER0_RX", "SER0_TX", "UART3_DE", "UART3_RE",
+		"WDT_TIME_OUT#", "UART1_DBG_RX", "UART1_DBG_TX", "SER2_RX";
+};
+
+&gpio0c {
+	gpio-line-names = "SPI0_SCK", "SPI0_MOSI", "SPI0_MISO", "SPI0_SS_IN",
+		"SPI0_CS0", "SPI0_CS1", "", "";
+};
+
+&gpio0d {
+	gpio-line-names = "SER2_TX", "GPIO10", "GPIO13", "I2C_PM_CK",
+		"I2C_PM_DAT", "I2C0_SMBALERT", "PCIE1_PERST#", "PCIE0_PERST#";
+};
+
+&gpio1a {
+	gpio-line-names = "I2C_GP_CK", "I2C_GP_DAT", "I2C2_SCL", "I2C2_SDA",
+		"I2C3_SCL", "I2C3_SDA", "UART_0_1_CROSS#", "FAN_TACHIN";
+};
+
+&gpio1b {
+	gpio-line-names = "HDMI_I2S_SCLK", "HDMI_I2S_LRCLK", "HDMI_I2S_SDOUT",
+		"", "GPIO1_CAM1_PWR#", "GPIO7", "UART0_DBG_TX", "UART0_DBG_RX";
+};
+
+&gpio1c {
+	gpio-line-names = "SPI1_SCK", "SPI1_MOSI", "SPI1_MISO", "SPI1_CS0",
+		"SPI1_CS1", "SPI1_CS2", "GPIO0_CAM0_PWR#", "SSI1_SS_IN";
+};
+
+&gpio1d {
+	gpio-line-names = "GPIO2_CAM0_RST#", "GPIO3_CAM1_RST#", "FAN_PWMOUT",
+		"LCD0_BKLT_PWM", "LCD1_BKLT_PWM", "GPIO8", "GPIO4_HDA_RST#",
+		"GPIO9";
+};
+
+/* ------------------------------------------------------------------ */
+/* Display pipeline                                                   */
+/* ------------------------------------------------------------------ */
+
