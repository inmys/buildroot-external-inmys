Subject: [PATCH] webrtcbin: forward feedback for bundled simulcast SSRCs

Backport the GStreamer 1.26 RTP funnel setting. A bundled input pad may
carry several SSRCs but caps advertise only one. Forward feedback for
other SSRCs so the outgoing simulcast funnel can select the right encoder.
Reference: https://github.com/GStreamer/gstreamer/blob/1.26.0/subprojects/gst-plugins-bad/ext/webrtc/gstwebrtcbin.c

--- a/ext/webrtc/gstwebrtcbin.c
+++ b/ext/webrtc/gstwebrtcbin.c
@@ -6145,8 +6145,12 @@
   if (webrtc->rtpfunnel)
     goto done;

   webrtc->rtpfunnel = gst_element_factory_make ("rtpfunnel", NULL);
+  if (g_object_class_find_property (G_OBJECT_GET_CLASS (webrtc->rtpfunnel),
+          "forward-unknown-ssrc") != NULL) {
+    g_object_set (webrtc->rtpfunnel, "forward-unknown-ssrc", TRUE, NULL);
+  }
   gst_bin_add (GST_BIN (webrtc), webrtc->rtpfunnel);
   gst_element_sync_state_with_parent (webrtc->rtpfunnel);

   srcpad = gst_element_get_static_pad (webrtc->rtpfunnel, "src");
