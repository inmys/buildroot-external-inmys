Subject: [PATCH] webrtcbin: associate local-offer MIDs before completion

Port the local-offer MID assignment timing from GStreamer 1.26. A browser
must expose transceiver.mid after setLocalDescription(offer), before the
remote answer. Otherwise applications initially publish no track IDs to
an SFU, despite the local SDP already containing those MIDs.
Match the transceiver that generated each pending MID and preserve mline
locks. Transport setup remains in the existing negotiation path.
Reference: https://github.com/GStreamer/gstreamer/blob/1.26.0/subprojects/gst-plugins-bad/ext/webrtc/gstwebrtcbin.c

--- a/ext/webrtc/gstwebrtcbin.c
+++ b/ext/webrtc/gstwebrtcbin.c
@@ -6495,6 +6495,50 @@
   return TRUE;
 }

+static gboolean
+transceiver_match_for_pending_mid (GstWebRTCRTPTransceiver * trans,
+    const gchar * mid)
+{
+  return g_strcmp0 (WEBRTC_TRANSCEIVER (trans)->pending_mid, mid) == 0;
+}
+
+/* Assign the offered MID before set-local-description completes, as in
+ * GStreamer 1.26. Applications use it to register their sending tracks. */
+static gboolean
+_associate_local_offer_transceivers (GstWebRTCBin * webrtc,
+    const GstSDPMessage * sdp, GError ** error)
+{
+  guint i;
+  for (i = 0; i < gst_sdp_message_medias_len (sdp); i++) {
+    const GstSDPMedia *media = gst_sdp_message_get_media (sdp, i);
+    const gchar *type = gst_sdp_media_get_media (media);
+    const gchar *mid = gst_sdp_media_get_attribute_val (media, "mid");
+    GstWebRTCRTPTransceiver *trans;
+
+    if (g_strcmp0 (type, "audio") && g_strcmp0 (type, "video"))
+      continue;
+    if (!mid) {
+      g_set_error (error, GST_WEBRTC_ERROR, GST_WEBRTC_ERROR_SDP_SYNTAX_ERROR,
+          "Missing mid attribute in media %u", i);
+      return FALSE;
+    }
+    if (_find_transceiver_for_mid (webrtc, mid))
+      continue;
+    trans = _find_transceiver (webrtc, mid,
+        (FindTransceiverFunc) transceiver_match_for_pending_mid);
+    if (!trans || (WEBRTC_TRANSCEIVER (trans)->mline_locked && trans->mline != i)) {
+      g_set_error (error, GST_WEBRTC_ERROR, GST_WEBRTC_ERROR_INVALID_STATE,
+          "No matching local transceiver for mid %s at mline %u", mid, i);
+      return FALSE;
+    }
+    trans->mline = i;
+    g_free (trans->mid);
+    trans->mid = g_strdup (mid);
+    g_object_notify (G_OBJECT (trans), "mid");
+  }
+  return TRUE;
+}
+
 /* http://w3c.github.io/webrtc-pc/#set-description */
 static GstStructure *
 _set_description_task (GstWebRTCBin * webrtc, struct set_description *sd)
@@ -6658,6 +6702,10 @@

   if (sd->source == SDP_REMOTE && sd->sdp->type == GST_WEBRTC_SDP_TYPE_OFFER &&
       !_associate_remote_offer_transceivers (webrtc, sd->sdp->sdp, &error))
+    goto out;
+
+  if (sd->source == SDP_LOCAL && sd->sdp->type == GST_WEBRTC_SDP_TYPE_OFFER &&
+      !_associate_local_offer_transceivers (webrtc, sd->sdp->sdp, &error))
     goto out;

   if (sd->sdp->type == GST_WEBRTC_SDP_TYPE_ROLLBACK) {
