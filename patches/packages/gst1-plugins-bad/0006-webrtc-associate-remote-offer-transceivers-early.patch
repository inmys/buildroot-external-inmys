Subject: [PATCH] webrtcbin: associate remote-offer transceivers before completion

Port the remote-offer association timing from GStreamer 1.26. Creating
receivers only during create-answer is too late for the browser to dispatch
track events from setRemoteDescription; SFU slots then have no tracks.
Reuse available matching-kind transceivers and preserve mline locks.
Reference: https://github.com/GStreamer/gstreamer/blob/1.26.0/subprojects/gst-plugins-bad/ext/webrtc/gstwebrtcbin.c

--- a/ext/webrtc/gstwebrtcbin.c
+++ b/ext/webrtc/gstwebrtcbin.c
@@ -6444,6 +6444,57 @@
 }


+/* Associate receive transceivers before set-remote-description completes,
+ * as in GStreamer 1.26. Browsers dispatch track events at this point, not
+ * when create-answer later happens to allocate the receive transceivers. */
+static gboolean
+_associate_remote_offer_transceivers (GstWebRTCBin * webrtc,
+    const GstSDPMessage * sdp, GError ** error)
+{
+  guint i;
+  for (i = 0; i < gst_sdp_message_medias_len (sdp); i++) {
+    const GstSDPMedia *media = gst_sdp_message_get_media (sdp, i);
+    const gchar *type = gst_sdp_media_get_media (media);
+    const gchar *mid = gst_sdp_media_get_attribute_val (media, "mid");
+    GstWebRTCKind kind;
+    GstWebRTCRTPTransceiver *trans;
+
+    if (!g_strcmp0 (type, "audio"))
+      kind = GST_WEBRTC_KIND_AUDIO;
+    else if (!g_strcmp0 (type, "video"))
+      kind = GST_WEBRTC_KIND_VIDEO;
+    else
+      continue;
+    if (!mid) {
+      g_set_error (error, GST_WEBRTC_ERROR, GST_WEBRTC_ERROR_SDP_SYNTAX_ERROR,
+          "Missing mid attribute in media %u", i);
+      return FALSE;
+    }
+    if (_find_transceiver_for_mid (webrtc, mid))
+      continue;
+    trans = _find_transceiver (webrtc, GINT_TO_POINTER (kind),
+        (FindTransceiverFunc) _find_compatible_unassociated_transceiver);
+    if (!trans) {
+      trans = GST_WEBRTC_RTP_TRANSCEIVER (_create_webrtc_transceiver (webrtc,
+              GST_WEBRTC_RTP_TRANSCEIVER_DIRECTION_RECVONLY, i, kind, NULL));
+      PC_UNLOCK (webrtc);
+      g_signal_emit (webrtc, gst_webrtc_bin_signals[ON_NEW_TRANSCEIVER_SIGNAL],
+          0, trans);
+      PC_LOCK (webrtc);
+    }
+    if (WEBRTC_TRANSCEIVER (trans)->mline_locked && trans->mline != i) {
+      g_set_error (error, GST_WEBRTC_ERROR, GST_WEBRTC_ERROR_INVALID_STATE,
+          "Transceiver has locked mline %u instead of %u", trans->mline, i);
+      return FALSE;
+    }
+    trans->mline = i;
+    g_free (trans->mid);
+    trans->mid = g_strdup (mid);
+    g_object_notify (G_OBJECT (trans), "mid");
+  }
+  return TRUE;
+}
+
 /* http://w3c.github.io/webrtc-pc/#set-description */
 static GstStructure *
 _set_description_task (GstWebRTCBin * webrtc, struct set_description *sd)
@@ -6604,6 +6655,10 @@
       break;
     }
   }
+
+  if (sd->source == SDP_REMOTE && sd->sdp->type == GST_WEBRTC_SDP_TYPE_OFFER &&
+      !_associate_remote_offer_transceivers (webrtc, sd->sdp->sdp, &error))
+    goto out;

   if (sd->sdp->type == GST_WEBRTC_SDP_TYPE_ROLLBACK) {
