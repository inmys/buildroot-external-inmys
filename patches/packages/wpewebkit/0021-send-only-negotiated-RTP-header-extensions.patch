+GRefPtr<GstCaps> RealtimeOutgoingMediaSourceGStreamer::negotiatedRtpCaps() const
+{
+    if (!m_webrtcSinkPad || !m_transceiver)
+        return nullptr;
+    auto webrtc = adoptGRef(gst_pad_get_parent_element(m_webrtcSinkPad.get()));
+    if (!webrtc)
+        return nullptr;
+    GUniqueOutPtr<GstWebRTCSessionDescription> description;
+    g_object_get(webrtc.get(), "remote-description", &description.outPtr(), nullptr);
+    if (!description || description->type != GST_WEBRTC_SDP_TYPE_ANSWER) {
+        g_object_get(webrtc.get(), "local-description", &description.outPtr(), nullptr);
+    }
+    if (!description || description->type != GST_WEBRTC_SDP_TYPE_ANSWER)
+        return nullptr;
+    unsigned index;
+    g_object_get(m_transceiver.get(), "mlineindex", &index, nullptr);
+    if (index >= gst_sdp_message_medias_len(description->sdp))
+        return nullptr;
+    return capsFromSDPMedia(gst_sdp_message_get_media(description->sdp, index));
+}
