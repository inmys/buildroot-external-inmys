Subject: [PATCH] WebRTC: send only negotiated RTP header extensions

Payloaders were configured from the local offer and kept sending declined
MID/NTP/color extensions after an answer. Select the accepted extensions
from the negotiated answer and disable automatic offer-based re-addition.
Refresh on MID notification even when the MID itself stays unchanged;
defer the description lookup out of the webrtcbin notification lock.

--- a/Source/WebCore/platform/mediastream/gstreamer/GStreamerRTPPacketizer.cpp
+++ b/Source/WebCore/platform/mediastream/gstreamer/GStreamerRTPPacketizer.cpp
@@ -70,19 +70,23 @@
 }

 GStreamerRTPPacketizer::~GStreamerRTPPacketizer() = default;

-void GStreamerRTPPacketizer::configureExtensions()
+void GStreamerRTPPacketizer::configureExtensions(const GstCaps* negotiatedCaps)
 {
     if (!webkitGstCheckVersion(1, 24, 0)) {
         GST_WARNING_OBJECT(m_bin.get(), "GStreamer 1.24 is required for configuring extensions on the RTP payloaders. Simulcast will not work.");
         return;
     }

-    auto parameters = rtpParameters();
+    auto parameters = negotiatedCaps && gst_caps_get_size(negotiatedCaps)
+        ? GUniquePtr<GstStructure>(gst_structure_copy(gst_caps_get_structure(negotiatedCaps, 0))) : rtpParameters();
     if (!parameters)
         return;

+    // After negotiation, only explicitly accepted extensions may be emitted.
+    // Automatic caps-based discovery would re-add declined offer extensions.
+    g_object_set(m_payloader.get(), "auto-header-extension", !negotiatedCaps, nullptr);
     g_signal_emit_by_name(m_payloader.get(), "clear-extensions");
     m_midExtension = nullptr;
     m_ridExtension = nullptr;
     m_lastExtensionId = 0;
