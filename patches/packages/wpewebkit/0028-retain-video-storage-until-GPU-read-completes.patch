Subject: [PATCH] video: keep imported storage alive until GPU reads finish

A V4L2 capture buffer returns to the VPU as soon as its last GstBuffer reference
is released. A DMA-BUF fd keeps the allocation alive but does not prevent the
VPU from overwriting it. Retain the source GstBuffer and wait for the last GPU
use when retiring the compositor buffer, instead of finishing every draw.

Use an EGL fence so retirement does not require a current GL context. This
avoids horizontal bands of old/new frames without copying raw pixels. Fall back
to glFinish only when an EGL fence cannot be created.

--- a/Source/WebCore/platform/graphics/texmap/coordinated/CoordinatedPlatformLayerBufferVideo.cpp
+++ b/Source/WebCore/platform/graphics/texmap/coordinated/CoordinatedPlatformLayerBufferVideo.cpp
@@ -25,8 +25,11 @@
  */

 #include "config.h"
 #include "CoordinatedPlatformLayerBufferVideo.h"
+#include "GLDisplay.h"
+#include "GLFenceEGL.h"
+#include "PlatformDisplay.h"

 #if USE(COORDINATED_GRAPHICS) && ENABLE(VIDEO) && USE(GSTREAMER)
 #include "CoordinatedPlatformLayerBufferExternalOES.h"
 #include "CoordinatedPlatformLayerBufferRGB.h"
@@ -59,15 +62,20 @@
 }

 CoordinatedPlatformLayerBufferVideo::CoordinatedPlatformLayerBufferVideo(GstBuffer* buffer, GstVideoInfo* videoInfo, std::optional<std::pair<uint32_t, uint64_t>> dmabufFormat, std::optional<GstVideoDecoderPlatform> videoDecoderPlatform, bool gstGLEnabled, OptionSet<TextureMapperFlags> flags)
     : CoordinatedPlatformLayerBuffer(Type::Video, IntSize(GST_VIDEO_INFO_WIDTH(videoInfo), GST_VIDEO_INFO_HEIGHT(videoInfo)), flags, nullptr)
+    , m_sourceBuffer(buffer)
     , m_videoDecoderPlatform(videoDecoderPlatform)
     , m_buffer(createBufferIfNeeded(buffer, videoInfo, dmabufFormat, gstGLEnabled))
 {
 }

 CoordinatedPlatformLayerBufferVideo::~CoordinatedPlatformLayerBufferVideo()
 {
+    // The VPU can overwrite imported DMA-BUF storage as soon as its GstBuffer
+    // returns to the capture pool. Keep it until the compositor's GPU read ends.
+    if (m_releaseFence)
+        m_releaseFence->clientWait();
     if (m_isMapped)
         gst_video_frame_unmap(&m_videoFrame);
 }

@@ -301,10 +309,20 @@
             }
         }
     }

-    if (m_buffer)
+    if (m_buffer) {
         m_buffer->paintToTextureMapper(textureMapper, targetRect, modelViewMatrix, opacity);
+#if HAVE(GL_FENCE)
+        auto& display = PlatformDisplay::sharedDisplay().glDisplay();
+        // Use an EGL fence: retiring a pending buffer may run off the GL thread.
+        // A later fence covers previous uses of this buffer in the same context.
+        if (display.checkVersion(1, 5) || display.extensions().KHR_fence_sync)
+            m_releaseFence = GLFenceEGL::create(display);
+        if (!m_releaseFence)
+            glFinish();
+#endif
+    }
 }

 } // namespace WebCore

--- a/Source/WebCore/platform/graphics/texmap/coordinated/CoordinatedPlatformLayerBufferVideo.h
+++ b/Source/WebCore/platform/graphics/texmap/coordinated/CoordinatedPlatformLayerBufferVideo.h
@@ -52,8 +52,10 @@
     std::unique_ptr<CoordinatedPlatformLayerBuffer> createBufferFromGLMemory(GstBuffer*, GstVideoInfo*);
 #endif

     GstVideoFrame m_videoFrame;
+    GRefPtr<GstBuffer> m_sourceBuffer;
+    std::unique_ptr<GLFence> m_releaseFence;
     std::optional<GstVideoDecoderPlatform> m_videoDecoderPlatform;
     bool m_isMapped { false };
     std::unique_ptr<CoordinatedPlatformLayerBuffer> m_buffer;
 };
