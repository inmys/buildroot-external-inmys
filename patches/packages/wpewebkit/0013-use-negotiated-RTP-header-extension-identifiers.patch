Subject: [PATCH] WebRTC: use negotiated IDs for outgoing RTP header extensions

Use the extmap IDs from negotiated caps for MID and simulcast RID, rather
than allocating unrelated IDs after the negotiated range. Configure audio
payloaders as well, so the SFU can identify both outgoing media sections.

--- a/Source/WebCore/platform/mediastream/gstreamer/GStreamerRTPPacketizer.cpp
+++ b/Source/WebCore/platform/mediastream/gstreamer/GStreamerRTPPacketizer.cpp
@@ -78,42 +78,52 @@
         return;
     }

+    auto parameters = rtpParameters();
+    if (!parameters)
+        return;
+
+    g_signal_emit_by_name(m_payloader.get(), "clear-extensions");
+    m_midExtension = nullptr;
+    m_ridExtension = nullptr;
     m_lastExtensionId = 0;
-
-    GValue extensions = G_VALUE_INIT;
-    g_object_get_property(G_OBJECT(m_payloader.get()), "extensions", &extensions);
-    RELEASE_ASSERT(GST_VALUE_HOLDS_ARRAY(&extensions));
-    m_lastExtensionId = gst_value_array_get_size(&extensions) + 1;
-    g_value_unset(&extensions);
-
-    if (!m_midExtension) {
-        m_midExtension = adoptGRef(gst_rtp_header_extension_create_from_uri(GST_RTP_HDREXT_BASE "sdes:mid"));
-        gst_rtp_header_extension_set_id(m_midExtension.get(), m_lastExtensionId);
-        GST_DEBUG_OBJECT(m_bin.get(), "Created mid extension %" GST_PTR_FORMAT, m_midExtension.get());
-        m_lastExtensionId++;
-        g_signal_emit_by_name(m_payloader.get(), "add-extension", m_midExtension.get());
-    }
-
-    // Invalidate rid and re-cache it from encoding parameters.
     m_rid = emptyString();
     auto rid = rtpStreamId();
     m_rid = rid;
-
-    if (!m_ridExtension) {
-        m_ridExtension = adoptGRef(gst_rtp_header_extension_create_from_uri(GST_RTP_HDREXT_BASE "sdes:rtp-stream-id"));
-        gst_rtp_header_extension_set_id(m_ridExtension.get(), m_lastExtensionId);
-        m_lastExtensionId++;
-        if (!rid.isEmpty())
-            g_object_set(m_ridExtension.get(), "rid", rid.utf8().data(), nullptr);
-        g_signal_emit_by_name(m_payloader.get(), "add-extension", m_ridExtension.get());
-    }
-
-    auto extension = adoptGRef(gst_rtp_header_extension_create_from_uri(GST_RTP_HDREXT_BASE "sdes:repaired-rtp-stream-id"));
-    gst_rtp_header_extension_set_id(extension.get(), m_lastExtensionId);
-    m_lastExtensionId++;
-    if (!rid.isEmpty())
-        g_object_set(extension.get(), "rid", rid.utf8().data(), nullptr);
-    g_signal_emit_by_name(m_payloader.get(), "add-extension", extension.get());
+    gstStructureForeach(parameters.get(), [&](auto id, const auto& value) -> bool {
+        auto key = gstIdToString(id);
+        if (!key.startsWith("extmap-"_s))
+            return true;
+        auto identifier = parseInteger<unsigned>(key.substring(7));
+        if (!identifier || !*identifier)
+            return true;
+        const GValue* uriValue = value;
+        if (GST_VALUE_HOLDS_ARRAY(value)) {
+            if (gst_value_array_get_size(value) < 2)
+                return true;
+            uriValue = gst_value_array_get_value(value, 1);
+        }
+        if (!G_VALUE_HOLDS_STRING(uriValue))
+            return true;
+        const char* uri = g_value_get_string(uriValue);
+        auto extension = adoptGRef(gst_rtp_header_extension_create_from_uri(uri));
+        if (!extension)
+            return true;
+        gst_rtp_header_extension_set_id(extension.get(), *identifier);
+        m_lastExtensionId = std::max(m_lastExtensionId, *identifier);
+        auto uriString = StringView::fromLatin1(uri);
+        if (uriString == GST_RTP_HDREXT_BASE "sdes:mid"_s) {
+            m_midExtension = extension;
+            if (!m_mid.isEmpty())
+                g_object_set(extension.get(), "mid", m_mid.utf8().data(), nullptr);
+        } else if (uriString == GST_RTP_HDREXT_BASE "sdes:rtp-stream-id"_s || uriString == GST_RTP_HDREXT_BASE "sdes:repaired-rtp-stream-id"_s) {
+            if (!rid.isEmpty())
+                g_object_set(extension.get(), "rid", rid.utf8().data(), nullptr);
+            if (uriString == GST_RTP_HDREXT_BASE "sdes:rtp-stream-id"_s)
+                m_ridExtension = extension;
+        }
+        g_signal_emit_by_name(m_payloader.get(), "add-extension", extension.get());
+        return true;
+    });
 }

