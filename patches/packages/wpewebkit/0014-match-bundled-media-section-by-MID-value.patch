Subject: [PATCH] WebRTC: keep BUNDLE header extensions and media IDs consistent

Use one URI-to-ID mapping for audio and video offers. Assigning ID 6 to
audio-level and video-color-space makes Chrome reject the BUNDLE offer.
When decoding MID, match its value to the actual SDP section before
copying attributes, so video cannot inherit the audio MSID/track ID.

--- a/Source/WebCore/Modules/mediastream/gstreamer/GStreamerWebRTCUtils.cpp
+++ b/Source/WebCore/Modules/mediastream/gstreamer/GStreamerWebRTCUtils.cpp
@@ -601,4 +601,17 @@
 GRefPtr<GstCaps> capsFromRtpCapabilities(const RTCRtpCapabilities& capabilities, Function<void(GstStructure*)> supplementCapsCallback)
 {
+    // BUNDLE shares one extension-ID namespace across audio and video.
+    HashMap<String, unsigned> extensionIds;
+    auto addExtensions = [&](const auto& extensions) {
+        for (auto& extension : extensions) {
+            if (!extensionIds.contains(extension.uri))
+                extensionIds.add(extension.uri, extensionIds.size() + 1);
+        }
+    };
+    auto& scanner = GStreamerRegistryScanner::singleton();
+    addExtensions(scanner.audioRtpExtensions());
+    addExtensions(scanner.videoRtpExtensions());
+    addExtensions(capabilities.headerExtensions);
+
     auto caps = adoptGRef(gst_caps_new_empty());
     for (unsigned index = 0; auto& codec : capabilities.codecs) {
@@ -625,6 +638,6 @@

         if (!index) {
-            for (unsigned i = 1; auto& extension : capabilities.headerExtensions)
-                gst_structure_set(codecStructure, makeString("extmap-"_s, i++).ascii().data(), G_TYPE_STRING, extension.uri.ascii().data(), nullptr);
+            for (auto& extension : capabilities.headerExtensions)
+                gst_structure_set(codecStructure, makeString("extmap-"_s, extensionIds.get(extension.uri)).ascii().data(), G_TYPE_STRING, extension.uri.ascii().data(), nullptr);
         }
         gst_caps_append_structure(caps.get(), codecStructure);
@@ -1120,4 +1133,8 @@
         }

+        // BUNDLE media sections often share the same extension ID. The MID
+        // value selects the section; do not attach the first section's MSID.
+        if (mid && g_strcmp0(mid.get(), gst_sdp_media_get_attribute_val(media, "mid")))
+            continue;
         if (mid) {
             gst_caps_set_simple(mediaCaps.get(), "a-mid", G_TYPE_STRING, mid.get(), nullptr);
