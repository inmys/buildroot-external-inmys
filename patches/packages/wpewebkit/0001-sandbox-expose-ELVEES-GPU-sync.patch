The ELVEES DDK needs pvr_sync in addition to the standard DRM nodes.
Keep this in the normal bubblewrap device allowlist without disabling
WebKit sandboxing. V4L2 codecs use the normal video device allowlist.

--- a/Source/WebKit/UIProcess/Launcher/glib/BubblewrapLauncher.cpp
+++ b/Source/WebKit/UIProcess/Launcher/glib/BubblewrapLauncher.cpp
@@ -442,6 +442,8 @@ static void bindOpenGL(Vector<CString>& args)
 {
     args.appendVector(Vector<CString>({
         "--dev-bind-try", "/dev/dri", "/dev/dri",
+        // ELVEES / Imagination PowerVR
+        "--dev-bind-try", "/dev/pvr_sync", "/dev/pvr_sync",
         // Mali
         "--dev-bind-try", "/dev/mali", "/dev/mali",
         "--dev-bind-try", "/dev/mali0", "/dev/mali0",
