Subject: [PATCH] video encoder: support the standard V4L2 H264 encoder

Register v4l2h264enc and map bitrate/GOP settings to its standard extra-controls.
The parser provides AVC access units for WebRTC and WebCodecs. This replaces
the board-specific OMX profile workaround when using the V4L2 frontend.

--- a/Source/WebCore/platform/gstreamer/VideoEncoderPrivateGStreamer.cpp
+++ b/Source/WebCore/platform/gstreamer/VideoEncoderPrivateGStreamer.cpp
@@ -128,6 +128,7 @@
     X265,
     OpenH264,
     OmxH264,
+    V4L2H264,
     VaapiH264,
     VaapiH264LP,
     VaapiH265,
@@ -236,6 +237,22 @@
     N_PROPS
 };

+static GUniquePtr<GstStructure> v4l2Controls(GObject* encoder)
+{
+    GUniqueOutPtr<GstStructure> controls;
+    g_object_get(encoder, "extra-controls", &controls.outPtr(), nullptr);
+    if (controls)
+        return GUniquePtr<GstStructure>(controls.release());
+    return GUniquePtr<GstStructure>(gst_structure_new_empty("controls"));
+}
+
+static void setV4L2Control(GObject* encoder, ASCIILiteral name, int value)
+{
+    auto controls = v4l2Controls(encoder);
+    gst_structure_set(controls.get(), name.characters(), G_TYPE_INT, value, nullptr);
+    g_object_set(encoder, "extra-controls", controls.get(), nullptr);
+}
+
 static void videoEncoderGetProperty(GObject* object, guint propertyId, GValue* value, GParamSpec* pspec)
 {
     auto* self = WEBKIT_VIDEO_ENCODER(object);
@@ -251,7 +268,11 @@
     case PROP_KEYFRAME_INTERVAL:
         if (priv->encoder) {
             auto encoder = Encoders::definition(priv->encoderId);
-            g_object_get_property(G_OBJECT(priv->encoder.get()), encoder->keyframeIntervalPropertyName.characters(), value);
+            if (priv->encoderId == V4L2H264) {
+                auto controls = v4l2Controls(G_OBJECT(priv->encoder.get()));
+                g_value_set_uint(value, gstStructureGet<int>(controls.get(), "video_gop_size"_s).value_or(15));
+            } else
+                g_object_get_property(G_OBJECT(priv->encoder.get()), encoder->keyframeIntervalPropertyName.characters(), value);
         }
         break;
     case PROP_BITRATE_MODE:
@@ -502,7 +523,11 @@
     case PROP_KEYFRAME_INTERVAL:
         if (priv->encoder) {
             auto encoder = Encoders::definition(priv->encoderId);
-            g_object_set(priv->encoder.get(), encoder->keyframeIntervalPropertyName.characters(), g_value_get_uint(value), nullptr);
+            if (priv->encoderId == V4L2H264) {
+                auto interval = g_value_get_uint(value);
+                setV4L2Control(G_OBJECT(priv->encoder.get()), "video_gop_size"_s, interval ? std::min(interval, 600u) : 600);
+            } else
+                g_object_set(priv->encoder.get(), encoder->keyframeIntervalPropertyName.characters(), g_value_get_uint(value), nullptr);
         }
