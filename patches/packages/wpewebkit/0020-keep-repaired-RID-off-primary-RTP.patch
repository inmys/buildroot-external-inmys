Subject: [PATCH] WebRTC: do not tag primary RTP as repaired streams

Only RTP retransmission/redundancy streams may carry RepairedRtpStreamId.
Set the RID on the primary stream-id extension only; leave repaired RID
for webrtcbin RTX. Otherwise a strict SFU can classify primary media as
repair packets.
Reference: https://www.rfc-editor.org/rfc/rfc8852.html#section-1

--- a/Source/WebCore/platform/mediastream/gstreamer/GStreamerRTPPacketizer.cpp
+++ b/Source/WebCore/platform/mediastream/gstreamer/GStreamerRTPPacketizer.cpp
@@ -115,11 +115,14 @@
             m_midExtension = extension;
             if (!m_mid.isEmpty())
                 g_object_set(extension.get(), "mid", m_mid.utf8().data(), nullptr);
-        } else if (uriString == GST_RTP_HDREXT_BASE "sdes:rtp-stream-id"_s || uriString == GST_RTP_HDREXT_BASE "sdes:repaired-rtp-stream-id"_s) {
+        } else if (uriString == GST_RTP_HDREXT_BASE "sdes:rtp-stream-id"_s) {
             if (!rid.isEmpty())
                 g_object_set(extension.get(), "rid", rid.utf8().data(), nullptr);
-            if (uriString == GST_RTP_HDREXT_BASE "sdes:rtp-stream-id"_s)
-                m_ridExtension = extension;
+            m_ridExtension = extension;
+        } else if (uriString == GST_RTP_HDREXT_BASE "sdes:repaired-rtp-stream-id"_s) {
+            // RFC 8852: repaired RID identifies a redundancy stream only.
+            // These payloaders emit primary media; RTX is handled by webrtcbin.
+            return true;
         }
         g_signal_emit_by_name(m_payloader.get(), "add-extension", extension.get());
         return true;
