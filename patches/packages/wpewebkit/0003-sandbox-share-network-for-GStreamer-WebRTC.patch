Subject: [PATCH] sandbox: allow GStreamer WebRTC to use host networking

WPE 2.50 runs webrtcbin/libnice in the web process. An isolated network
namespace prevents ICE gathering and connections to STUN/TURN peers.
Share networking only for the GStreamer WebRTC web process; retain the
filesystem and seccomp sandbox. Non-WebRTC builds preserve network isolation. Bind the udev database read-only
so the GStreamer V4L2 device provider can discover the bound camera nodes.

--- a/Source/WebKit/UIProcess/Launcher/glib/BubblewrapLauncher.cpp
+++ b/Source/WebKit/UIProcess/Launcher/glib/BubblewrapLauncher.cpp
@@ -686,7 +686,13 @@
     // gdbserver requires network access for remote debugging.
     if (enableDebugPermissions() && g_str_has_suffix(argv[0], "gdbserver"))
         return false;
-
+
+#if USE(GSTREAMER_WEBRTC)
+    // In WPE 2.50 libnice performs ICE/DTLS inside the web process.
+    if (processType == ProcessLauncher::ProcessType::Web)
+        return false;
+#endif
+
     // xdg-dbus-proxy needs access to host abstract sockets to connect to the a11y bus. Secure
     // host services must not use abstract sockets.
     if (processType == ProcessLauncher::ProcessType::DBusProxy)
--- a/Source/WebKit/UIProcess/Launcher/glib/BubblewrapLauncher.cpp
+++ b/Source/WebKit/UIProcess/Launcher/glib/BubblewrapLauncher.cpp
@@ -468,4 +468,6 @@
 {
     args.appendVector(Vector<CString>({
+        // GUdev requires ID_V4L_VERSION from the udev database to discover cameras.
+        "--ro-bind-try", "/run/udev", "/run/udev",
         "--dev-bind-try", "/dev/v4l", "/dev/v4l",
         // Not pretty but a stop-gap for pipewire anyway.
