Check the GBM plane-export API instead of a Mesa version number. ELVEES
Mesa 17 has the required backports but cannot allocate explicit modifiers.
Restore the conditional modifier-surface path used by Weston 10; the
existing implicit-layout fallback remains unchanged.

--- a/libweston/meson.build
+++ b/libweston/meson.build
@@ -87,7 +87,16 @@
 subdir('desktop')
 subdir('shell-utils')
 
-dep_gbm = dependency('gbm', required: false, version: '>= 21.1.1')
+# The vendor Mesa branch backports plane APIs without changing its version.
+dep_gbm = dependency('gbm', required: false)
+if dep_gbm.found()
+	if not cc.has_function('gbm_bo_get_fd_for_plane', prefix: '#include <gbm.h>', dependencies: dep_gbm)
+		error('GBM must provide gbm_bo_get_fd_for_plane')
+	endif
+	if cc.has_function('gbm_surface_create_with_modifiers', prefix: '#include <gbm.h>', dependencies: dep_gbm)
+		config_h.set('HAVE_GBM_MODIFIERS', '1')
+	endif
+endif
 
