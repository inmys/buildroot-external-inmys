+#define GPIO3_10 106
+void rgmii_reset(void)
+{
+	int ret;
+	/* reset RGMII phy */
+	ret = gpio_request(GPIO3_10, "rgmii_rst");
+	if (ret != 0) {
+		printf("failed to export GPIO %d: %d\n", GPIO3_10, ret);
+		return;
+	}
+	gpio_direction_output(GPIO3_10, 0); // do reset
+	udelay(100);
+	gpio_direction_output(GPIO3_10, 1); // no reset
+}
 
