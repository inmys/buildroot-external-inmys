From: INMYS <support@inmys.ru>
Subject: [PATCH] board: elvees: refresh factory MACs from module EUI-48 EEPROMs

NMS-SM-K1892VM21YA carries two 24AA025E48 EEPROMs behind PCA9540B.
The device tree assigns them an inmys,eth-index; the factory EUI-48
is stored at 0xfa..0xff. Reject erased, zero and multicast addresses.

Always consult these EEPROMs, including when ethaddr/eth1addr already
contain globally administered values. A shared/cloned SD may retain
another module's MACs; accepting them makes U-Boot's Linux FDT fixup
hide the correct Linux nvmem address and duplicates DHCP identities.

Refresh and save the environment only when a validated hardware MAC
changed. Boards without EUI-48 nodes retain the vendor fallback policy.
The module U-Boot fragment enables ENV_OVERWRITE for this refresh.

Signed-off-by: INMYS <support@inmys.ru>
---
--- a/board/elvees/common/factory-settings.c
+++ b/board/elvees/common/factory-settings.c
@@ -7,6 +7,7 @@
 #include <ctype.h>
 #include <dm.h>
 #include <dm/of_access.h>
+#include <dm/uclass.h>
 #include <env.h>
 #include <env_internal.h>
 #include <i2c.h>
@@ -377,8 +378,130 @@
-	return ret;
+	return ret;
 }
 
+/*
+ * Factory MAC addresses
+ *
+ * The INMYS NMS-SM-K1892VM21YA module carries two 24AA025E48 EUI-48
+ * EEPROMs (D11/D12, SOT-23-6) on the I2C_INT_1V8 branch behind the
+ * PCA9540B multiplexer.  The 6-byte EUI-48 address lives in the last
+ * six bytes of the 256-byte array (0xfa..0xff); the rest of the array
+ * is free for the customer.
+ *
+ * The device tree describes them as
+ *
+ *	mac-eeprom@50 {
+ *		compatible = "inmys,eui48-eeprom";
+ *		reg = <0x50>;
+ *		inmys,eth-index = <0>;
+ *	};
+ *
+ * where "inmys,eth-index" says which Ethernet port the address belongs
+ * to (0 -> ethaddr/GBE0, 1 -> eth1addr/GBE1).
+ */
+#define EUI48_EEPROM_COMPAT	"inmys,eui48-eeprom"
+#define EUI48_MAC_OFFSET	0xfa
+#define EUI48_MAC_LEN		6
+
+static ofnode find_eui48_eeprom(u32 eth_index)
+{
+	ofnode node = ofnode_null();
+
+	for (node = ofnode_by_compatible(node, EUI48_EEPROM_COMPAT);
+	     ofnode_valid(node);
+	     node = ofnode_by_compatible(node, EUI48_EEPROM_COMPAT)) {
+		u32 index;
+
+		if (ofnode_read_u32(node, "inmys,eth-index", &index))
+			continue;
+		if (index == eth_index)
+			return node;
+	}
+
+	return ofnode_null();
+}
+
+static int read_eui48_eeprom(ofnode node, char *mac_str)
+{
+	struct udevice *bus, *chip;
+	ofnode bus_node;
+	u8 mac[EUI48_MAC_LEN];
+	u32 addr;
+	int i, ret;
+
+	ret = ofnode_read_u32(node, "reg", &addr);
+	if (ret)
+		return ret;
+
+	bus_node = ofnode_get_parent(node);
+	if (!ofnode_valid(bus_node))
+		return -ENODEV;
+
+	ret = uclass_get_device_by_ofnode(UCLASS_I2C, bus_node, &bus);
+	if (ret)
+		return ret;
+
+	/* The 24AA025E48 uses a single-byte register address */
+	ret = i2c_get_chip(bus, addr, 1, &chip);
+	if (ret)
+		return ret;
+
+	ret = dm_i2c_read(chip, EUI48_MAC_OFFSET, mac, EUI48_MAC_LEN);
+	if (ret)
+		return ret;
+
+	/* An erased or blank EEPROM must not be used as a MAC address */
+	for (i = 0; i < EUI48_MAC_LEN; i++)
+		if (mac[i] != 0x00 && mac[i] != 0xff)
+			break;
+	if (i == EUI48_MAC_LEN)
+		return -ENODATA;
+
+	/* A multicast/broadcast address is not a valid station address */
+	if (mac[0] & 0x01)
+		return -EINVAL;
+
+	sprintf(mac_str, "%02x:%02x:%02x:%02x:%02x:%02x",
+		mac[0], mac[1], mac[2], mac[3], mac[4], mac[5]);
+
+	return 0;
+}
+
+/* The module EEPROM is authoritative even on a cloned/removable SD.
+ * Return true only when a validated hardware MAC changed the environment.
+ */
+static bool set_mac_from_eeprom(u32 eth_index, const char *env_name)
+{
+	char mac_str[18];
+	const char *cur;
+	ofnode node;
+
+	node = find_eui48_eeprom(eth_index);
+	if (!ofnode_valid(node)) {
+		log_debug("No EUI-48 EEPROM for %s in the device tree\n", env_name);
+		return false;
+	}
+
+	if (read_eui48_eeprom(node, mac_str)) {
+		log_err("Unable to read the EUI-48 EEPROM for %s\n", env_name);
+		return false;
+	}
+
+	cur = env_get(env_name);
+	if (cur && !strcmp(cur, mac_str)) {
+		log_notice("%s: %s (verified EUI-48 EEPROM)\n", env_name, mac_str);
+		return false;
+	}
+	if (env_set(env_name, mac_str)) {
+		log_err("Unable to set %s to %s\n", env_name, mac_str);
+		return false;
+	}
+	log_notice("%s: %s (from EUI-48 EEPROM)\n", env_name, mac_str);
+	return true;
+}
+
 int do_factory_settings(const char *board_name)
 {
+	bool mac_changed;
-	int ret = 0;
