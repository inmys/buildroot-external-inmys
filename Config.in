comment "NMS-SM-K1892VM21YA support needs an AArch64 target"
	depends on !BR2_aarch64

if BR2_aarch64

source "$BR2_EXTERNAL_INMYS_NMS_SM_K1892_PATH/package/ddrinit/Config.in"
source "$BR2_EXTERNAL_INMYS_NMS_SM_K1892_PATH/package/elvees-mcom03-tools/Config.in"
source "$BR2_EXTERNAL_INMYS_NMS_SM_K1892_PATH/package/kconfiglib/Config.in"
source "$BR2_EXTERNAL_INMYS_NMS_SM_K1892_PATH/package/mcom03-sbl/Config.in"
source "$BR2_EXTERNAL_INMYS_NMS_SM_K1892_PATH/package/tusb926x-flash-burner/Config.in"

source "$BR2_EXTERNAL_INMYS_NMS_SM_K1892_PATH/package/elvees-sensor-phy/Config.in"

source "$BR2_EXTERNAL_INMYS_NMS_SM_K1892_PATH/package/elvees-dmabuf-exporter/Config.in"

source "$BR2_EXTERNAL_INMYS_NMS_SM_K1892_PATH/package/elvees-felix/Config.in"

source "$BR2_EXTERNAL_INMYS_NMS_SM_K1892_PATH/package/elvees-gst-felix/Config.in"

source "$BR2_EXTERNAL_INMYS_NMS_SM_K1892_PATH/package/elvees-rogue-modules/Config.in"
source "$BR2_EXTERNAL_INMYS_NMS_SM_K1892_PATH/package/elvees-powervr-opencl/Config.in"
source "$BR2_EXTERNAL_INMYS_NMS_SM_K1892_PATH/package/elvees-powervr-graphics/Config.in"
source "$BR2_EXTERNAL_INMYS_NMS_SM_K1892_PATH/package/elvees-elcore50/Config.in"
source "$BR2_EXTERNAL_INMYS_NMS_SM_K1892_PATH/package/elvees-elcorenn/Config.in"
source "$BR2_EXTERNAL_INMYS_NMS_SM_K1892_PATH/package/elvees-yolov8n/Config.in"
source "$BR2_EXTERNAL_INMYS_NMS_SM_K1892_PATH/package/elvees-vpu-modules/Config.in"
source "$BR2_EXTERNAL_INMYS_NMS_SM_K1892_PATH/package/inmys-vision/Config.in"

source "$BR2_EXTERNAL_INMYS_NMS_SM_K1892_PATH/package/inmys-browser/Config.in"

endif
