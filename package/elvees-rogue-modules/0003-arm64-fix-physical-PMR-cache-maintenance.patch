-
-	dma_sync_single_for_cpu(dev, bus_addr, size, DMA_FROM_DEVICE);
-
-	dma_unmap_single(dev, bus_addr, size, DMA_FROM_DEVICE);
+	PVR_UNREFERENCED_PARAMETER(psDevNode);
