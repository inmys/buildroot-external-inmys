 obj-m += $(INTERNAL_KBUILD_OBJECTS)
+
+# Linux 6.13+ builds external modules with relative source/object paths.
+# Explicit source targets avoid implicit-rule chaining through generated links.
+pvr_sources := $(sort $(patsubst %.o,%.c,$($(PVRSRVKM_NAME)-y)))
+$(filter-out generated/% external/%,$(pvr_sources)): %.c: $(TOP)/%.c
+	$(symlink-source-file)
+$(filter generated/%,$(pvr_sources)): generated/%.c: $(bridge_base)/%.c
+	$(symlink-source-file)
+$(filter external/%,$(pvr_sources)): external/%.c: $(abspath $(srctree))/%.c
+	$(symlink-source-file)
