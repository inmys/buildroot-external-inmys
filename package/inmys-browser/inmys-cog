#!/bin/sh
set -eu
export HOME=${NMS_BROWSER_HOME:-/var/lib/browser}
export XDG_RUNTIME_DIR=/run/inmys-browser/client
export WAYLAND_DISPLAY=/run/inmys-browser/weston/wayland-0
export EGL_PLATFORM=wayland
export WEBKIT_WEB_RENDER_DEVICE_FILE=/dev/dri/renderD128
# Scope analog audio selection to this browser process tree.
export ALSA_CARD=${ALSA_CARD:-analogaudio}
export ALSA_PCM_CARD=${ALSA_PCM_CARD:-analogaudio}
export WEBKIT_GST_ENABLE_AUDIO_MIXER=1
# Mesa 17 cannot enumerate DMA-BUF formats; NV12 plane imports are validated.
export WEBKIT_GST_DMABUF_FORMATS=NV12
# Use the stateful V4L2 decoder for H.264, including MSE seek/flush.
export GST_PLUGIN_FEATURE_RANK=${GST_PLUGIN_FEATURE_RANK:-v4l2h264dec:512,v4l2h264enc:512}
# Avoid progressive MP4 stalls caused by GstDownloadBuffer buffering pauses.
export WPE_SHELL_DISABLE_MEDIA_DISK_CACHE=${WPE_SHELL_DISABLE_MEDIA_DISK_CACHE:-1}
export COG_USER_STYLE_SHEET="${COG_USER_STYLE_SHEET-/etc/inmys-browser/rutube-low-effects.css}"
export COG_USER_STYLE_SHEET_ALLOWLIST="${COG_USER_STYLE_SHEET_ALLOWLIST-https://rutube.ru/*;https://*.rutube.ru/*}"
exec dbus-run-session -- cog --platform=wl --webprocess-failure=exit "$@"
