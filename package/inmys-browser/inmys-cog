#!/bin/sh
set -eu
export HOME=${NMS_BROWSER_HOME:-/var/lib/browser}
export XDG_RUNTIME_DIR=/run/inmys-browser/client
export WAYLAND_DISPLAY=/run/inmys-browser/weston/wayland-0
export EGL_PLATFORM=wayland
# The vendor decoder exports ordinary video buffers, not EGLImages.
export WEBKIT_GST_DISABLE_GL_SINK=1
exec dbus-run-session -- cog --platform=wl --webprocess-failure=exit "$@"
