config BR2_PACKAGE_INMYS_BROWSER
	bool "manual Weston + Cog session"
	depends on BR2_LINUX_KERNEL && BR2_PACKAGE_HAS_UDEV
	depends on BR2_ENABLE_LOCALE && BR2_USE_WCHAR && BR2_USE_MMU
	depends on BR2_INSTALL_LIBSTDCPP && BR2_TOOLCHAIN_USES_GLIBC
	depends on BR2_TOOLCHAIN_HAS_THREADS_NPTL && !BR2_STATIC_LIBS
	depends on BR2_TOOLCHAIN_HEADERS_AT_LEAST_3_12
	depends on BR2_PACKAGE_LIBSECCOMP_ARCH_SUPPORTS
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_11 && BR2_HOST_GCC_AT_LEAST_7
	select BR2_PACKAGE_ELVEES_POWERVR_GRAPHICS
	select BR2_PACKAGE_ELVEES_VPU_MODULES
	select BR2_PACKAGE_WESTON
	select BR2_PACKAGE_WESTON_DRM
	select BR2_PACKAGE_WPEWEBKIT
	select BR2_PACKAGE_WPEWEBKIT_SANDBOX
	select BR2_PACKAGE_WPEWEBKIT_MULTIMEDIA
	select BR2_PACKAGE_COG
	select BR2_PACKAGE_COG_PLATFORM_FDO
	select BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_AUDIOPARSERS
	select BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_V4L2
	select BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_V4L2_PROBE
	select BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_VIDEOPARSERS
	select BR2_PACKAGE_GST1_PLUGINS_BASE_LIB_OPENGL
	select BR2_PACKAGE_GST1_PLUGINS_BASE_LIB_OPENGL_GLES2
	select BR2_PACKAGE_GST1_PLUGINS_BASE_LIB_OPENGL_EGL
	select BR2_PACKAGE_GST1_PLUGINS_BASE_LIB_OPENGL_WAYLAND
	select BR2_PACKAGE_WPEWEBKIT_USE_GSTREAMER_GL
	select BR2_PACKAGE_CA_CERTIFICATES
	select BR2_PACKAGE_GLIB_NETWORKING
	select BR2_PACKAGE_SHARED_MIME_INFO
	select BR2_PACKAGE_DEJAVU
	help
	  inmys-browser URL stops inmys-vision and runs Weston and Cog.
	  On exit, it releases the display and restarts inmys-vision.
	  Nothing is started automatically at boot.
