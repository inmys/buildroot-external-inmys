+GBM_EXPORT struct gbm_bo *
+gbm_bo_create_with_modifiers(struct gbm_device *gbm,
+                             uint32_t width, uint32_t height, uint32_t format,
+                             const uint64_t *modifiers, unsigned int count)
+{
+   return gbm_bo_create_with_modifiers2(gbm, width, height, format,
+                                       modifiers, count, 0);
+}
+
+GBM_EXPORT struct gbm_bo *
+gbm_bo_create_with_modifiers2(struct gbm_device *gbm,
+                              uint32_t width, uint32_t height, uint32_t format,
+                              const uint64_t *modifiers, unsigned int count,
+                              uint32_t flags)
+{
+   if (!width || !height || (count && !modifiers) || (modifiers && !count)) {
+      errno = EINVAL;
+      return NULL;
+   }
+   if (!modifiers)
+      return gbm_bo_create(gbm, width, height, format, flags);
+
+   /* This Mesa branch predates DRI createImageWithModifiers. Do not allocate
+    * an implicitly laid out image and mislabel it as an explicit modifier.
+    * Clients may fall back to ordinary GBM_BO_USE_LINEAR allocation. */
+   errno = ENOSYS;
+   return NULL;
+}
