+/* Plane accessors adapted from Mesa 17.3.9. DRI v8 lacks plane queries, but
+ * the legacy RGB/R/RG formats below are unambiguously single-plane. Do not
+ * guess the plane count for imported YUV formats on older image drivers. */
+static int
+gbm_dri_bo_get_planes(struct gbm_bo *_bo)
+{
+   struct gbm_dri_device *dri = gbm_dri_device(_bo->gbm);
+   struct gbm_dri_bo *bo = gbm_dri_bo(_bo);
+   int count = 0;
+
+   if (!bo->image)
+      return 1;
+   if (dri->image->base.version >= 11 &&
+       dri->image->queryImage(bo->image, __DRI_IMAGE_ATTRIB_NUM_PLANES, &count) &&
+       count > 0)
+      return count;
+   switch (_bo->format) {
+   case GBM_BO_FORMAT_XRGB8888:
+   case GBM_BO_FORMAT_ARGB8888:
+   case GBM_FORMAT_XRGB8888:
+   case GBM_FORMAT_ARGB8888:
+   case GBM_FORMAT_XBGR8888:
+   case GBM_FORMAT_ABGR8888:
+   case GBM_FORMAT_RGB565:
+   case GBM_FORMAT_R8:
+   case GBM_FORMAT_GR88:
+   case GBM_FORMAT_ARGB2101010:
+   case GBM_FORMAT_XRGB2101010:
+      return 1;
+   default:
+      errno = ENOSYS;
+      return 0;
+   }
+}
+
+static int
+gbm_dri_bo_query_plane(struct gbm_bo *_bo, int plane, int attrib, int *value)
+{
+   struct gbm_dri_device *dri = gbm_dri_device(_bo->gbm);
+   struct gbm_dri_bo *bo = gbm_dri_bo(_bo);
+   int count = gbm_dri_bo_get_planes(_bo);
+   __DRIimage *image;
+   int result;
+
+   if (plane < 0 || plane >= count) {
+      errno = EINVAL;
+      return 0;
+   }
+   if (!bo->image || (count == 1 && dri->image->base.version < 11)) {
+      switch (attrib) {
+      case __DRI_IMAGE_ATTRIB_HANDLE: *value = _bo->handle.s32; return 1;
+      case __DRI_IMAGE_ATTRIB_STRIDE: *value = _bo->stride; return 1;
+      /* The legacy BO allocator/import-FD interface starts at offset zero. */
+      case __DRI_IMAGE_ATTRIB_OFFSET: *value = 0; return 1;
+      case __DRI_IMAGE_ATTRIB_FD:
+         *value = gbm_dri_bo_get_fd(_bo);
+         return *value >= 0;
+      default: errno = ENOSYS; return 0;
+      }
+   }
+   image = dri->image->fromPlanar ?
+      dri->image->fromPlanar(bo->image, plane, NULL) : NULL;
+   if (!image && plane != 0) {
+      errno = ENOSYS;
+      return 0;
+   }
+   result = dri->image->queryImage(image ? image : bo->image, attrib, value);
+   if (image)
+      dri->image->destroyImage(image);
+   if (!result)
+      errno = ENOSYS;
+   return result;
+}
+
+static union gbm_bo_handle
+gbm_dri_bo_get_handle_for_plane(struct gbm_bo *bo, int plane)
+{
+   union gbm_bo_handle result;
+   result.s32 = -1;
+   gbm_dri_bo_query_plane(bo, plane, __DRI_IMAGE_ATTRIB_HANDLE, &result.s32);
+   return result;
+}
+
+static uint32_t
+gbm_dri_bo_get_stride_for_plane(struct gbm_bo *bo, int plane)
+{
+   int stride = 0;
+   gbm_dri_bo_query_plane(bo, plane, __DRI_IMAGE_ATTRIB_STRIDE, &stride);
+   return stride;
+}
+
+static int
+gbm_dri_bo_get_fd_for_plane(struct gbm_bo *bo, int plane)
+{
+   int fd = -1;
+   gbm_dri_bo_query_plane(bo, plane, __DRI_IMAGE_ATTRIB_FD, &fd);
+   return fd;
+}
+
+static uint32_t
+gbm_dri_bo_get_offset(struct gbm_bo *bo, int plane)
+{
+   int offset = 0;
+   gbm_dri_bo_query_plane(bo, plane, __DRI_IMAGE_ATTRIB_OFFSET, &offset);
+   return offset;
+}
+
+static uint64_t
+gbm_dri_bo_get_modifier(struct gbm_bo *_bo)
+{
+   struct gbm_dri_device *dri = gbm_dri_device(_bo->gbm);
+   struct gbm_dri_bo *bo = gbm_dri_bo(_bo);
+   int upper, lower;
+
+   if (!bo->image)
+      return DRM_FORMAT_MOD_LINEAR;
+   if (dri->image->base.version >= 14 &&
+       dri->image->queryImage(bo->image, __DRI_IMAGE_ATTRIB_MODIFIER_UPPER, &upper) &&
+       dri->image->queryImage(bo->image, __DRI_IMAGE_ATTRIB_MODIFIER_LOWER, &lower))
+      return ((uint64_t)(uint32_t)upper << 32) | (uint32_t)lower;
+   /* INVALID means implicit layout, not a claim that the allocation is linear. */
+   errno = ENOSYS;
+   return DRM_FORMAT_MOD_INVALID;
+}
