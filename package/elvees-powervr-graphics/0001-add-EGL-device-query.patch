+/* SPDX-License-Identifier: MIT */
+/* EXT_device_query and EXT_device_drm_render_node for the legacy DRI backend.
+ * Device identity comes from the DRM fd actually used by the EGL display.
+ * Device enumeration and platform-device creation are deliberately not exposed.
+ */
+#include <stdlib.h>
+#include <string.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <xf86drm.h>
+#include "c11/threads.h"
+#include "egldevice.h"
+#include "eglcurrent.h"
+#include "eglglobals.h"
+
+struct egl_drm_device {
+   struct egl_drm_device *next;
+   char *node;
+   char *render_node;
+};
+
+static mtx_t device_mutex = _MTX_INITIALIZER_NP;
+static struct egl_drm_device *devices;
+static EGLBoolean cleanup_registered;
+
+static void
+free_devices(void)
+{
+   struct egl_drm_device *device;
+   mtx_lock(&device_mutex);
+   while ((device = devices)) {
+      devices = device->next;
+      free(device->node);
+      free(device->render_node);
+      free(device);
+   }
+   mtx_unlock(&device_mutex);
+}
+
+/* The legacy MCom-03 PVR support library receives the display-controller fd
+ * from Wayland, then opens its render device internally. Resolve that separate
+ * device by its kernel driver, only when exactly one PVR render node exists.
+ * Refuse ambiguous multi-PVR systems instead of guessing an association.
+ */
+static int
+unique_pvr_render_fd(void)
+{
+   drmDevicePtr candidates[32];
+   int count = drmGetDevices2(0, candidates, 32);
+   int result = -1, matches = 0, i;
+   if (count < 0)
+      return -1;
+   for (i = 0; i < count; i++) {
+      int fd;
+      drmVersionPtr version;
+      if (!(candidates[i]->available_nodes & (1 << DRM_NODE_RENDER)))
+         continue;
+      fd = open(candidates[i]->nodes[DRM_NODE_RENDER], O_RDWR | O_CLOEXEC);
+      if (fd < 0)
+         continue;
+      version = drmGetVersion(fd);
+      if (version && version->name && !strcmp(version->name, "pvr")) {
+         matches++;
+         if (result >= 0)
+            close(result);
+         result = fd;
+      } else {
+         close(fd);
+      }
+      drmFreeVersion(version);
+   }
+   drmFreeDevices(candidates, count);
+   if (matches != 1 && result >= 0) {
+      close(result);
+      result = -1;
+   }
+   return result;
+}
+
+EGLDeviceEXT
+_eglDeviceForFD(int fd, const char *driver_name)
+{
+   struct egl_drm_device *device;
+   char *node = drmGetPrimaryDeviceNameFromFd(fd);
+   char *render_node = drmGetRenderDeviceNameFromFd(fd);
+   EGLBoolean register_cleanup = EGL_FALSE;
+
+   if (!render_node && driver_name && !strcmp(driver_name, "pvr")) {
+      int render_fd = unique_pvr_render_fd();
+      if (render_fd >= 0) {
+         free(node);
+         node = drmGetPrimaryDeviceNameFromFd(render_fd);
+         render_node = drmGetRenderDeviceNameFromFd(render_fd);
+         close(render_fd);
+      }
+   }
+
+   if (!node && !render_node)
+      return EGL_NO_DEVICE_EXT;
+
+   mtx_lock(&device_mutex);
+   for (device = devices; device; device = device->next) {
+      if ((render_node && device->render_node &&
+           !strcmp(render_node, device->render_node)) ||
+          (node && device->node && !strcmp(node, device->node)))
+         break;
+   }
+   if (!device) {
+      device = calloc(1, sizeof(*device));
+      if (device) {
+         device->node = node;
+         device->render_node = render_node;
+         node = render_node = NULL;
+         device->next = devices;
+         devices = device;
+         if (!cleanup_registered) {
+            cleanup_registered = EGL_TRUE;
+            register_cleanup = EGL_TRUE;
+         }
+      }
+   }
+   mtx_unlock(&device_mutex);
+   free(node);
+   free(render_node);
+   if (register_cleanup)
+      _eglAddAtExitCall(free_devices);
+   return (EGLDeviceEXT) device;
+}
+
+/* Compare opaque handles before dereferencing; invalid client pointers are safe. */
+static struct egl_drm_device *
+lookup_device(EGLDeviceEXT handle)
+{
+   struct egl_drm_device *device;
+   for (device = devices; device; device = device->next) {
+      if ((EGLDeviceEXT) device == handle)
+         return device;
+   }
+   return NULL;
+}
+
+EGLBoolean
+_eglDeviceIsValid(EGLDeviceEXT handle)
+{
+   EGLBoolean valid;
+   mtx_lock(&device_mutex);
+   valid = lookup_device(handle) != NULL;
+   mtx_unlock(&device_mutex);
+   return valid;
+}
+
+const char *
+_eglDeviceQueryString(EGLDeviceEXT handle, EGLint name)
+{
+   struct egl_drm_device *device;
+   const char *result = NULL;
+   EGLint error = EGL_SUCCESS;
+   mtx_lock(&device_mutex);
+   device = lookup_device(handle);
+   if (!device) {
+      error = EGL_BAD_DEVICE_EXT;
+   } else if (name == EGL_EXTENSIONS) {
+      result = device->render_node ? "EGL_EXT_device_drm_render_node" : "";
+   } else if (name == EGL_DRM_RENDER_NODE_FILE_EXT && device->render_node) {
+      result = device->render_node;
+   } else {
+      /* EXT_device_drm requires device_base/enumeration, not implemented here. */
+      error = EGL_BAD_PARAMETER;
+   }
+   mtx_unlock(&device_mutex);
+   _eglError(error, "eglQueryDeviceStringEXT");
+   return result;
+}
