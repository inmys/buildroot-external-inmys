+/*
+ * Minimal hidraw stand-in for hidapi.
+ *
+ * The upstream Makefile links against hidapi-hidraw, but Buildroot's hidapi
+ * package hard-depends on libudev, and this image deliberately runs without
+ * udev.  Nothing here needs hidapi: on Linux its hidraw backend is a thin
+ * wrapper over the kernel driver, and the burner only uses
+ *
+ *   hid_open()   -> open("/dev/hidrawN") + HIDIOCGRAWINFO
+ *   hid_write()  -> write(fd, data, length)
+ *
+ * which is exactly what hidapi's hid_write() does.  The kernel's
+ * usbhid_output_report() strips the leading byte only when it is 0x00, so
+ * the nine-byte command buffers below reach the interrupt OUT endpoint
+ * unchanged, byte for byte as they did through hidapi.
+ */
+
+struct hid_device_ {
+	int fd;
+};
+typedef struct hid_device_ hid_device;
+
+struct hid_device_info {
+	unsigned short vendor_id;
+	unsigned short product_id;
+	unsigned short release_number;
+	unsigned short usage;
+	unsigned short usage_page;
+	int interface_number;
+	char *path;
+	wchar_t *serial_number;
+	wchar_t *manufacturer_string;
+	wchar_t *product_string;
+	struct hid_device_info *next;
+};
+
+static inline int hid_init(void) { return 0; }
+static inline int hid_exit(void) { return 0; }
+
+static hid_device *hid_open(unsigned short vendor_id, unsigned short product_id,
+			    const wchar_t *serial_number)
+{
+	char path[64];
+	struct hidraw_devinfo info;
+	hid_device *dev;
+	int fd, i;
+
+	(void)serial_number;
+
+	for (i = 0; i < 64; i++) {
+		snprintf(path, sizeof(path), "/dev/hidraw%d", i);
+		fd = open(path, O_RDWR | O_CLOEXEC);
+		if (fd < 0)
+			continue;
+		/* hidraw_devinfo.vendor/product are __s16, and 0x926b does
+		 * not fit in a signed 16-bit value, so compare unsigned. */
+		if (ioctl(fd, HIDIOCGRAWINFO, &info) == 0 &&
+		    (unsigned short)info.vendor == vendor_id &&
+		    (unsigned short)info.product == product_id) {
+			dev = (hid_device *)calloc(1, sizeof(*dev));
+			if (NULL == dev) {
+				close(fd);
+				return NULL;
+			}
+			dev->fd = fd;
+			return dev;
+		}
+		close(fd);
+	}
+	return NULL;
+}
+
+static int hid_write(hid_device *dev, const unsigned char *data, size_t length)
+{
+	return (int)write(dev->fd, data, length);
+}
+
+static void hid_close(hid_device *dev)
+{
+	if (NULL == dev)
+		return;
+	close(dev->fd);
+	free(dev);
+}
+
+/*
+ * Enumeration only feeds the "Device Found" banner; the burner locates its
+ * device by VID/PID anyway, so there is nothing to report here.
+ */
+static struct hid_device_info *hid_enumerate(unsigned short vendor_id,
+					     unsigned short product_id)
+{
+	(void)vendor_id;
+	(void)product_id;
+	return NULL;
+}
 
