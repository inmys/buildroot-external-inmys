config BR2_PACKAGE_ELVEES_GST_OMX
	bool "ELVEES GStreamer OpenMAX VPU plugin"
	depends on BR2_LINUX_KERNEL && BR2_TOOLCHAIN_USES_GLIBC && !BR2_STATIC_LIBS
	depends on BR2_TOOLCHAIN_HAS_THREADS && BR2_USE_WCHAR && BR2_USE_MMU
	select BR2_PACKAGE_ELVEES_VPU_LIBS
	select BR2_PACKAGE_GST1_PLUGINS_BASE
	help
	  Source-built ELVEES gst-omx fork, including omxh264enc/omxmjpegenc
	  and the corresponding hardware decoder elements.
