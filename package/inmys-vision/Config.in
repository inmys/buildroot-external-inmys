config BR2_PACKAGE_INMYS_VISION
	bool "inmys CSI video: HDMI, H.264 RTSP and HTTP MJPEG"
	depends on BR2_LINUX_KERNEL && BR2_TOOLCHAIN_USES_GLIBC
	depends on BR2_INSTALL_LIBSTDCPP && !BR2_STATIC_LIBS
	depends on BR2_TOOLCHAIN_HAS_THREADS && BR2_USE_WCHAR && BR2_USE_MMU
	select BR2_PACKAGE_LIBGPIOD
	select BR2_PACKAGE_ELVEES_GST_FELIX
	select BR2_PACKAGE_ELVEES_VPU_MODULES
	select BR2_PACKAGE_ELVEES_ELCORENN
	select BR2_PACKAGE_ELVEES_YOLOV8N
	select BR2_PACKAGE_GST1_PLUGINS_BASE
	select BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_APP
	select BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_VIDEOCONVERTSCALE
	select BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_VIDEORATE
	select BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_VIDEOTESTSRC
	select BR2_PACKAGE_GST1_PLUGINS_GOOD
	select BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_V4L2
	select BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_V4L2_PROBE
	select BR2_PACKAGE_GST1_PLUGINS_GOOD_JPEG
	select BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_IMAGEFREEZE
	select BR2_PACKAGE_GST1_PLUGINS_BAD
	select BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_KMS
	select BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_VIDEOPARSERS
	select BR2_PACKAGE_GST1_PLUGINS_UGLY
	select BR2_PACKAGE_GST1_PLUGINS_UGLY_PLUGIN_X264
	select BR2_PACKAGE_GST1_RTSP_SERVER
	help
	  Felix ISP capture, optional HDMI, shared H.264 RTSP and browser
	  MJPEG preview with YOLOv8n inference on ELcore50 DSP.
	  H.264 and MJPEG encoding runs on Mali-V61 VPU. Software encoders
	  remain available through an explicit command-line option.
	  There is no CPU inference fallback.
