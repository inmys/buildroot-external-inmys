#
# INMYS NMS-SM-K1892VM21YA V1 (ELVEES MCom-03R / К1892ВМ21Я) SMARC module
#
# Default carrier: NMS-SM-EVM V1
#

# Fail over to the Buildroot mirror instead of hanging on a stalled
# download (several upstream sites are very slow or unresponsive).
BR2_WGET="wget -nd -t 2 --connect-timeout=10 --timeout=45"

# Architecture
BR2_aarch64=y
# Use the 6.18 kernel headers (the kernel itself is built from the
# elvees/linux mcom03-6.18.y branch via a custom git repository, for
# which Buildroot cannot derive the headers version automatically).
BR2_KERNEL_HEADERS_6_18=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# System
BR2_TARGET_GENERIC_HOSTNAME="nms-sm-k1892"
BR2_TARGET_GENERIC_ISSUE="NMS-SM-K1892VM21YA (ELVEES MCom-03R)"
BR2_TARGET_GENERIC_ROOT_PASSWD="root"
BR2_SYSTEM_DHCP="eth0"
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_INMYS_NMS_SM_K1892_PATH)/board/nms-sm-k1892vm21ya/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_INMYS_NMS_SM_K1892_PATH)/board/nms-sm-k1892vm21ya/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_INMYS_NMS_SM_K1892_PATH)/board/nms-sm-k1892vm21ya/post-image.sh"

# Kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="https://github.com/elvees/linux"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="mcom03-6.18.y"
BR2_LINUX_KERNEL_DEFCONFIG="mcom03r"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_INMYS_NMS_SM_K1892_PATH)/board/nms-sm-k1892vm21ya/linux/nms-sm-k1892vm21ya_linux.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="elvees/nms-sm-evm elvees/nms-smarc-tester elvees/nms-itx-sm-lc-v4 elvees/nms-sm-elvsmarccb"
BR2_LINUX_KERNEL_DTB_KEEP_DIRNAME=y
BR2_LINUX_KERNEL_INSTALL_TARGET=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_PATCH="$(BR2_EXTERNAL_INMYS_NMS_SM_K1892_PATH)/patches/linux"

# TF-A
BR2_TARGET_ARM_TRUSTED_FIRMWARE=y
BR2_TARGET_ARM_TRUSTED_FIRMWARE_CUSTOM_GIT=y
BR2_TARGET_ARM_TRUSTED_FIRMWARE_CUSTOM_REPO_URL="https://github.com/elvees/arm-trusted-firmware"
BR2_TARGET_ARM_TRUSTED_FIRMWARE_CUSTOM_REPO_VERSION="mcom03"
BR2_TARGET_ARM_TRUSTED_FIRMWARE_PLATFORM="mcom03"
BR2_TARGET_ARM_TRUSTED_FIRMWARE_SSP=y

# U-Boot
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_GIT=y
BR2_TARGET_UBOOT_CUSTOM_REPO_URL="https://github.com/elvees/u-boot"
BR2_TARGET_UBOOT_CUSTOM_REPO_VERSION="mcom03"
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="mcom03r"
BR2_TARGET_UBOOT_NEEDS_DTC=y
BR2_TARGET_UBOOT_NEEDS_PYLIBFDT=y
BR2_TARGET_UBOOT_NEEDS_PYELFTOOLS=y
BR2_TARGET_UBOOT_NEEDS_OPENSSL=y
BR2_TARGET_UBOOT_PATCH="$(BR2_EXTERNAL_INMYS_NMS_SM_K1892_PATH)/patches/uboot"
BR2_TARGET_UBOOT_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_INMYS_NMS_SM_K1892_PATH)/board/nms-sm-k1892vm21ya/uboot/nms-sm-k1892vm21ya_uboot.fragment"
BR2_PACKAGE_HOST_UBOOT_TOOLS=y
BR2_PACKAGE_HOST_UBOOT_TOOLS_ENVIMAGE=y
BR2_PACKAGE_HOST_UBOOT_TOOLS_ENVIMAGE_SIZE="0x10000"

# MCom-03 boot chain
BR2_PACKAGE_DDRINIT=y
BR2_PACKAGE_MCOM03_SBL=y
BR2_NMS_SM_K1892_CARRIER="nms-sm-evm"
BR2_NMS_SM_K1892_SBL_CONFIG="$(BR2_EXTERNAL_INMYS_NMS_SM_K1892_PATH)/board/nms-sm-k1892vm21ya/nms-sm-k1892vm21ya-sbl-config.toml"

# Host tools for image generation
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y

# Filesystem
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_SIZE="512M"
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_TAR_GZIP=y

# Debug / bring-up tools
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_I2C_TOOLS=y
BR2_PACKAGE_LIBGPIOD=y
BR2_PACKAGE_LIBGPIOD_TOOLS=y
# A/B updates: SWUpdate writes the inactive rootfs and flips extlinux.conf
BR2_PACKAGE_SWUPDATE=y
BR2_PACKAGE_SWUPDATE_CONFIG="$(BR2_EXTERNAL_INMYS_NMS_SM_K1892_PATH)/board/nms-sm-k1892vm21ya/swupdate.config"
BR2_PACKAGE_LIBCONFIG=y
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_ZLIB=y
# STM32 system-bootloader flasher, used by /usr/sbin/bc-flash.sh
BR2_PACKAGE_STM32FLASH=y
BR2_PACKAGE_MDIO_TOOLS=y
BR2_PACKAGE_ETHTOOL=y
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_CAN_UTILS=y
BR2_PACKAGE_USBUTILS=y
BR2_PACKAGE_PCIUTILS=y
# v4l2-ctl, so the HDMI loop through the tester's MS2130 grabber can be
# captured and not only reported: the module's ADV7513 feeds the grabber,
# which comes back as a UVC device on the module's own USB.
BR2_PACKAGE_LIBV4L=y
BR2_PACKAGE_LIBV4L_UTILS=y
# modetest, to move the single mali-dp CRTC between LVDS and HDMI at runtime.
# The SoC has one CRTC and no cloning, so the two connectors are exclusive and
# which one is driven is a KMS decision, not a device-tree one.
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_LIBDRM_INSTALL_TESTS=y
# iperf3, to measure the two GbE ports against something other than a ping.
# The module's PHYs are DAP8211 on both ports and the SMARC connector brings
# them out separately, so throughput has to be measured per port.
BR2_PACKAGE_IPERF3=y
BR2_PACKAGE_MTD=y
BR2_PACKAGE_MTD_MKFSJFFS2=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT=y
BR2_PACKAGE_STRESS_NG=y
BR2_PACKAGE_MEMTESTER=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_DROPBEAR_CLIENT=y
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_LRZSZ=y
BR2_PACKAGE_UBOOT_TOOLS=y
BR2_PACKAGE_UBOOT_TOOLS_FWPRINTENV=y

# --- Audio userspace ------------------------------------------------------
# aplay/arecord for the smoke test, amixer for the ES8327 mixer controls and
# speaker-test for the channel check.
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_ALSACTL=y
BR2_PACKAGE_ALSA_UTILS_SPEAKER_TEST=y

# --- USB-SATA bridge ------------------------------------------------------
# D16 (TUSB9261) has no firmware in D15 and sits in its HID boot loader.  The
# SPI flash is reachable from nothing but the bridge, and the bridge is on a
# hub port that is not on the SMARC connector, so the SoC is the only host
# that can program it: tusb926x-flash-burner runs on the module and drives the
# boot loader over /dev/hidraw.  Requires CONFIG_HIDRAW=y (kernel fragment).
BR2_PACKAGE_LIBUSB=y
BR2_PACKAGE_TUSB926X_FLASH_BURNER=y

# --- WiFi -----------------------------------------------------------------
# Intel AX210 in the M.2 slot (PCIe).  linux-firmware is only used for the
# selected blobs; IWLWIFI_6E covers the Typhoon Peak iwlwifi-ty-a0-gf-a0
# firmware, RTL_815X the Realtek 2.5G USB dongles that otherwise log a
# missing rtl_nic/rtl8156b-2.fw at every boot.
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_6E=y
# The slot has been seen with an AX210 (Typhoon Peak, iwlwifi-ty-*) and with
# a Dual Band Wireless-AC 7265 (Stone Peak 2, iwlwifi-7265D-*), so both
# blobs are installed and the driver picks by PCI ID.
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_7265D=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_815X=y
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
